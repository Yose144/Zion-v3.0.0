[Unit]
Description=ZION V31 Node 3 (Follower, P2P sync to Node 1)
After=network-online.target zion-v31-node.service
Wants=network-online.target
Requires=zion-v31-node.service

[Service]
Type=simple
User=zion
Group=zion
WorkingDirectory=/opt/zion
EnvironmentFile=/etc/zion/edge-environment.sh
Environment="RUST_LOG=info"
ExecStart=/opt/zion/V31/target/release/zion-node \
    --db-path /opt/zion/data/v31/node3.db \
    --rpc 127.0.0.1:9447 \
    --p2p 0.0.0.0:8337 \
    --node-id zion-v31-node-3 \
    --peer 127.0.0.1:8335 \
    --v3-no-genesis \
    --human zion1y3w4z0c755v4y7t3f0k6s54390x0h3k3y5hv8c8 \
    --issobella zion1z4s3a54266f2x7j4x7c27297k49752t7k52l0f0
Restart=always
RestartSec=10
KillMode=process
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=yes
ReadWritePaths=/data/zion /opt/zion/data /opt/zion/logs /var/log/zion
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target

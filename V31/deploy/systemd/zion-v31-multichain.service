[Unit]
Description=ZION V31 Multi-Chain WARP Relay
After=network-online.target zion-v31-node.service
Wants=network-online.target
Requires=zion-v31-node.service

[Service]
Type=simple
User=zion
Group=zion
WorkingDirectory=/opt/zion
EnvironmentFile=/etc/zion/edge-environment.sh
Environment="RUST_LOG=info,zion_multichain=debug"
ExecStart=/opt/zion/V31/target/release/warpd --config /etc/zion/warp.toml --listen 127.0.0.1:8453 --db /data/zion/warp.db
Restart=always
RestartSec=10
KillMode=process
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

# Security hardening (unprivileged zion user)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=yes
ReadWritePaths=/data/zion /opt/zion/data /opt/zion/logs /var/log/zion
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target

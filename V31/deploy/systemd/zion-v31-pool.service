[Unit]
Description=ZION V31 Pool (Primary)
After=network-online.target zion-v31-node.service
Wants=network-online.target
Requires=zion-v31-node.service

[Service]
Type=simple
User=zion
Group=zion
WorkingDirectory=/opt/zion
EnvironmentFile=/etc/zion/edge-environment.sh
Environment="RUST_LOG=info,zion_pool=debug"
ExecStart=/opt/zion/V31/target/release/zion-pool \
    --bind 0.0.0.0:8444 \
    --l1-rpc-url http://127.0.0.1:9445 \
    --miner-address ${ZION_POOL_WALLET} \
    --state-path /opt/zion/data/v31/pool-pplns.json \
    --pool-fee-bps 100 \
    --pplns-window-size 500000000 \
    --store-db-path /opt/zion/data/v31/pool-store.db
Restart=always
RestartSec=10
KillMode=process
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

# Security hardening (unprivileged zion user)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=yes
ReadWritePaths=/data/zion /opt/zion/data /opt/zion/logs /var/log/zion
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target

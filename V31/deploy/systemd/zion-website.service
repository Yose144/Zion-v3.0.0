[Unit]
Description=ZION Website (Next.js)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zion
Group=zion
WorkingDirectory=/opt/zion/APP&WEB/website-v2.9
EnvironmentFile=/etc/zion/website-v31-environment.sh
Environment="HOSTNAME=127.0.0.1"
ExecStart=/usr/local/bin/node .next/standalone/server.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Security hardening (unprivileged zion user)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=yes
ReadWritePaths=/opt/zion/APP&WEB/website-v2.9/logs
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target

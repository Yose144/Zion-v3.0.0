[Unit]
Description=ZION V31 CPU/GPU Miner
After=network.target zion-v31-pool.service
Wants=zion-v31-pool.service

[Service]
Type=simple
User=zion
Group=zion
WorkingDirectory=/opt/zion
EnvironmentFile=/etc/zion/edge-environment.sh
Environment=ZION_POOL_ADDR=127.0.0.1:8444
Environment=ZION_WORKER_NAME=v31-miner
Environment=ZION_MINER_ID=v31-miner-1
Environment=ZION_THREADS=2
Environment=ZION_GPU_BACKEND=auto
ExecStart=/opt/zion/V31/target/release/zion-miner --pool 127.0.0.1:8444 --worker v31-miner --threads 2
Restart=always
RestartSec=30

# Security hardening (unprivileged zion user)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=yes
ReadWritePaths=/data/zion /opt/zion/data /opt/zion/logs /var/log/zion

[Install]
WantedBy=multi-user.target

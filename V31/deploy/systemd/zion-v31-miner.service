[Unit]
Description=ZION V31 Edge CPU miner (ZION-only)
After=network.target zion-v31-pool.service
Wants=zion-v31-pool.service

[Service]
Type=simple
User=zion
Group=zion
WorkingDirectory=/opt/zion
EnvironmentFile=/etc/zion/edge-environment.sh
Environment=ZION_POOL_ADDR=127.0.0.1:8444
ExecStart=/opt/zion/V31/target/release/zion-miner --pool 127.0.0.1:8444 --wallet ${ZION_MINER_WALLET} --worker ${ZION_MINER_WORKER} --threads ${ZION_MINER_THREADS} --no-gpu --no-cpu
Restart=always
RestartSec=30
Nice=10
CPUQuota=400%

# Security hardening (unprivileged zion user)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=yes
ReadWritePaths=/data/zion /opt/zion/data /opt/zion/logs /var/log/zion

[Install]
WantedBy=multi-user.target

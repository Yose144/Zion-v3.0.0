[Unit]
Description=ZION V31 Free World Humanitarian Tracker
After=network-online.target zion-v31-node.service zion-v31-dao.service
Wants=network-online.target

[Service]
Type=simple
User=zion
Group=zion
WorkingDirectory=/opt/zion
EnvironmentFile=/etc/zion/edge-environment.sh
Environment="RUST_LOG=info,zion_free_world=debug"
Environment="FREE_WORLD_BIND=127.0.0.1"
Environment="FREE_WORLD_PORT=8095"
Environment="FREE_WORLD_DB=/data/zion/free_world.db"
Environment="FREE_WORLD_L1_RPC=http://127.0.0.1:9445/jsonrpc"
ExecStart=/opt/zion/V31/target/release/zion-free-world
Restart=always
RestartSec=10
KillMode=process
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

# Security hardening (unprivileged zion user)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=yes
ReadWritePaths=/data/zion /opt/zion/data /opt/zion/logs /var/log/zion
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target

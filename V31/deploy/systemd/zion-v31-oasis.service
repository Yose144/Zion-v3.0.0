[Unit]
Description=ZION V31 OASIS Game API
After=network-online.target zion-v31-node.service
Wants=network-online.target

[Service]
Type=simple
User=zion
Group=zion
WorkingDirectory=/opt/zion
EnvironmentFile=/etc/zion/edge-environment.sh
Environment="RUST_LOG=info,zion_oasis=debug"
Environment="OASIS_PORT=8094"
Environment="OASIS_BIND=127.0.0.1"
Environment="OASIS_DB=/data/zion/oasis-v31.db"
Environment="OASIS_METRICS_PORT=9102"
Environment="OASIS_L1_RPC_URL=http://127.0.0.1:9445"
ExecStart=/opt/zion/V31/target/release/zion-oasis
Restart=always
RestartSec=10
KillMode=process
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

# Security hardening (unprivileged zion user)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=yes
ReadWritePaths=/data/zion /opt/zion/data /opt/zion/logs /var/log/zion
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target

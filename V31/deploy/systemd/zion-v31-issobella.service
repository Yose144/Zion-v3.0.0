[Unit]
Description=ZION V31 Issobella Space Tracker
After=network-online.target zion-v31-node.service zion-v31-dao.service
Wants=network-online.target

[Service]
Type=simple
User=zion
Group=zion
WorkingDirectory=/opt/zion
EnvironmentFile=/etc/zion/edge-environment.sh
Environment="RUST_LOG=info,zion_issobella=debug"
Environment="ISSOBELLA_BIND=127.0.0.1"
Environment="ISSOBELLA_PORT=8096"
Environment="ISSOBELLA_DB=/data/zion/issobella.db"
Environment="ISSOBELLA_L1_RPC=http://127.0.0.1:9445/jsonrpc"
ExecStart=/opt/zion/V31/target/release/zion-issobella
Restart=always
RestartSec=10
KillMode=process
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

# Security hardening (unprivileged zion user)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=yes
ReadWritePaths=/data/zion /opt/zion/data /opt/zion/logs /var/log/zion
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target

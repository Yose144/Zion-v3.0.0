# ZION V3 Mainnet Docker Environment — Example
# =============================================================================
# WARNING: This is an EXAMPLE template. NEVER commit real secrets to git.
# Copy this file to .env.mainnet, fill in your values, and keep it outside
# version control.
#
# Quick start:
#   cp V3/docker/.env.mainnet.example V3/docker/.env.mainnet
#   nano V3/docker/.env.mainnet
#   docker compose -f V3/docker/docker-compose.yml --profile mainnet up -d
# =============================================================================

# ==================== LOGGING ====================
RUST_LOG=info
TAG=latest

# ==================== PORTS ====================
P2P_PORT=8333
RPC_PORT=8443
POOL_PORT=8444
METRICS_PORT=9115

# ==================== NODE ====================
ZION_NODE_ID=v3-mainnet-001
ZION_NODE_STATE_PATH=/data/zion/state
ZION_P2P_BIND=0.0.0.0:8333
ZION_RPC_BIND=0.0.0.0:8443

# Bootstrap: leave empty for Greenfield (genesis) node.
# For follower nodes, set to a known seed peer.
ZION_SEED_PEERS=

# Replace with YOUR wallet addresses (these example addresses are public).
ZION_MINER_ADDRESS=REPLACE_WITH_YOUR_MINER_ADDRESS
ZION_HUMANITARIAN_WALLET=REPLACE_WITH_YOUR_HUMANITARIAN_WALLET
ZION_ISSOBELLA_WALLET=REPLACE_WITH_YOUR_ISSOBELLA_WALLET
ZION_POOL_FEE_WALLET=REPLACE_WITH_YOUR_POOL_FEE_WALLET

# Optional: override protocol percentages (defaults 5 / 5 / 1).
# Only change if a DAO governance vote has approved a new split.
# ZION_HUMANITARIAN_TITHE_PCT=5
# ZION_ISSOBELLA_FUND_PCT=5
# ZION_POOL_FEE_PCT=1

# ==================== POOL ====================
ZION_POOL_BIND=0.0.0.0:8444
ZION_NODE_RPC_ADDR=node:8443
POOL_LOOP_COUNT=1000000
ZION_MAX_SESSIONS_PER_IP=10

ZION_POOL_WALLET=REPLACE_WITH_YOUR_POOL_WALLET

# CRITICAL: Pool payout private key. Generate a fresh key with:
#   cargo run --manifest-path V3/Cargo.toml -p zion-core --bin gen-keys
# NEVER reuse an example or publicly known key — any payouts signed with a
# leaked key can be stolen by anyone.
ZION_POOL_PAYOUT_SK_HEX=REPLACE_WITH_YOUR_POOL_PAYOUT_SECRET_KEY

# ==================== MINER (optional local miner) ====================
ZION_MINER_THREADS=2
MINER_LOOP_COUNT=1000000

# ==================== GRAFANA (monitoring profile) ====================
# Required when using --profile monitoring.
GF_SECURITY_ADMIN_PASSWORD=REPLACE_WITH_STRONG_GRAFANA_PASSWORD

# ==================== HIRAN INFERENCE (optional) ====================
HIRAN_TAG=v2.2
HIRAN_PORT=8002
HIRAN_CTX_SIZE=4096
HIRAN_N_GPU_LAYERS=99
HIRAN_THREADS=4

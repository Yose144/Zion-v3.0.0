# ─────────────────────────────────────────────────────────────────────────────
# ZION V3 Docker Compose Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Ankr RPC ─────────────────────────────────────────────────────────────────
# Free tier API key — higher rate limits than no key.
# Get from: https://app.ankr.com
# Used by: zion-bridge (L2), LiFiWidget (via website RPC config)
ANKR_API_KEY=your_ankr_api_key_here

# ── Bridge Validator Keys ────────────────────────────────────────────────────
# Set in secrets manager or .env (NEVER commit)
# ZION_VALIDATOR_PRIVATE_KEY=
# ZION_VALIDATOR_EXTRA_KEYS=     # comma-separated
# ZION_VALIDATOR_EXTRA_IDS=      # optional comma-separated IDs

# ── Bridge Config ────────────────────────────────────────────────────────────
# Mainnet or testnet config
ZION_BRIDGE_CONFIG=/etc/zion/bridge-mainnet.toml

# ZION V3 Docker Environment — Example
# Copy to .env and customize for your environment

# ==================== LOGGING ====================
RUST_LOG=info,zion_core=debug,zion_pool=debug
TAG=latest

# ==================== PORTS ====================
P2P_PORT=8333
RPC_PORT=8443
POOL_PORT=8444
METRICS_PORT=9115

# ==================== NODE ====================
ZION_NODE_ID=v3-mainnet-local
ZION_NODE_STATE_PATH=/data/zion/state
ZION_P2P_BIND=0.0.0.0:8333
ZION_RPC_BIND=0.0.0.0:8443
# Greenfield bootstrap host: leave empty. Followers: uncomment and set to primary P2P.
ZION_SEED_PEERS=
# ZION_SEED_PEERS=204.168.245.175:8333

# Canonical mainnet defaults match `zion_core::genesis` (docker-compose uses these too).
# Regenerate editable block (incl. ZION_POOL_PAYOUT_SK_HEX):
#   cargo run --manifest-path V3/Cargo.toml -p zion-core --release --bin canonical-mainnet-operator-env

ZION_MINER_ADDRESS=zion1f8m55606u500z8l7f8p7n85588s3x70048c66j3
ZION_HUMANITARIAN_WALLET=zion1m4v5z8z850u480c5c208z274e334369275n5y20
ZION_ISSOBELLA_WALLET=zion19242q4x0l3785003n8l0s873k3f5v8d4d8wz702
ZION_POOL_FEE_WALLET=zion1p2a7a5q0t2z5z545y6m6j5e864n002v4z6w95w5

# Optional: override percentages (defaults 5 / 5 / 1).
# ZION_HUMANITARIAN_TITHE_PCT=5
# ZION_ISSOBELLA_FUND_PCT=5
# ZION_POOL_FEE_PCT=1

# ==================== MINER ====================
ZION_MINER_THREADS=2
MINER_LOOP_COUNT=1000000

# ==================== POOL ====================
ZION_POOL_BIND=0.0.0.0:8444
ZION_NODE_RPC_ADDR=node:8443
POOL_LOOP_COUNT=1000000
# Max TCP sessions per client IP (anti-DoS). Use 0 only for stress tests (100+ workers behind one NAT).
# ZION_MAX_SESSIONS_PER_IP=0

ZION_POOL_WALLET=zion1l56685k280p364g686j88644g3j4r375755e8p7
# CRITICAL: Pool payout private key. Generate with:
#   cargo run --manifest-path V3/Cargo.toml -p zion-core --bin gen-keys
# NEVER use the example value in production; it is public.
ZION_POOL_PAYOUT_SK_HEX=REPLACE_WITH_YOUR_POOL_PAYOUT_SECRET_KEY

# ==================== BUILD ====================
BUILD_PROFILE=release

# ==================== MONITORING ====================
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_RETENTION=30d

# ==================== HIRAN v2.2 INFERENCE ====================
HIRAN_TAG=v2.2
HIRAN_PORT=8002
HIRAN_MODEL=/models/hiran-v2.2-q5_k_m.gguf
HIRAN_BACKEND=llama_cpp
HIRAN_DEVICE=cuda
HIRAN_CTX_SIZE=4096
HIRAN_N_GPU_LAYERS=99
HIRAN_THREADS=4

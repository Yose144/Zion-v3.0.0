# ZION V3 L2 profile example
# Copy to V3/docker/.env.l2 and edit for target environment.

# Common
RUST_LOG=info

# Select config profiles (defaults in compose are testnet)
# Testnet:
# ZION_BRIDGE_CONFIG=/etc/zion/bridge-testnet.toml
# ZION_SWAP_CONFIG=/etc/zion/swap-testnet.toml
# ZION_DAO_CONFIG=/etc/zion/dao-testnet.toml

# Mainnet:
ZION_BRIDGE_CONFIG=/etc/zion/bridge-mainnet.toml
ZION_SWAP_CONFIG=/etc/zion/swap-mainnet.toml
ZION_DAO_CONFIG=/etc/zion/dao-mainnet.toml

# Bridge validator signing
# Required: local validator key (hex)
ZION_VALIDATOR_PRIVATE_KEY=
# Optional: additional validators for local fan-in
# ZION_VALIDATOR_EXTRA_KEYS=0x...,0x...
# ZION_VALIDATOR_EXTRA_IDS=validator-2,validator-3

# Core-side bridge unlock validation policy (set on zion-core host)
# ZION_BRIDGE_VALIDATOR_PUBKEYS=0x...,0x...,0x...
# ZION_BRIDGE_VALIDATOR_THRESHOLD=3

# Atomic swap secrets
ZION_SWAP_ESCROW_KEY=
# ZION_RPC_TOKEN=

# DAO secret
# ZION_DAO_API_KEY=

# Optional premium EVM RPC
# ANKR_API_KEY=

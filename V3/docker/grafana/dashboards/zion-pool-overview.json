{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Active Miner Sessions",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "expr": "zion_pool_active_sessions", "legendFormat": "sessions", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "thresholds": { "steps": [
          { "color": "red", "value": null },
          { "color": "green", "value": 1 }
        ]}}
      }
    },
    {
      "title": "Uptime",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        { "expr": "zion_pool_uptime_seconds", "legendFormat": "uptime", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "Total Shares (Accepted / Rejected)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        { "expr": "zion_pool_total_accepted", "legendFormat": "accepted", "refId": "A" },
        { "expr": "zion_pool_total_submits - zion_pool_total_accepted", "legendFormat": "rejected", "refId": "B" }
      ]
    },
    {
      "title": "PPLNS Window Usage",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        { "expr": "zion_pplns_window_used / zion_pplns_window_size", "legendFormat": "fill %", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "thresholds": { "steps": [
        { "color": "green", "value": null },
        { "color": "yellow", "value": 0.8 },
        { "color": "red", "value": 0.95 }
      ]}}}
    },
    {
      "title": "Shares Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "expr": "rate(zion_pool_total_accepted[5m])", "legendFormat": "accepted/s", "refId": "A" },
        { "expr": "rate(zion_pool_total_submits[5m]) - rate(zion_pool_total_accepted[5m])", "legendFormat": "rejected/s", "refId": "B" }
      ]
    },
    {
      "title": "PPLNS Payouts",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "expr": "zion_pplns_payout_rounds", "legendFormat": "rounds", "refId": "A" },
        { "expr": "zion_pplns_total_paid_flowers / 1e15", "legendFormat": "paid ZION", "refId": "B" }
      ],
      "fieldConfig": { "defaults": {} }
    },
    {
      "title": "Registered Miners",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 12 },
      "targets": [
        { "expr": "zion_pplns_registered_miners", "legendFormat": "miners", "refId": "A" }
      ]
    },
    {
      "title": "Revenue Source Distribution",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 12 },
      "targets": [
        { "expr": "zion_pool_source_submits", "legendFormat": "{{source}}", "refId": "A" }
      ]
    },
    {
      "title": "Host CPU Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        { "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)", "legendFormat": "CPU %", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100 } }
    },
    {
      "title": "Host Memory Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        { "expr": "(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100", "legendFormat": "Memory %", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100 } }
    },
    {
      "title": "Disk Usage",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [
        { "expr": "(1 - node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"}) * 100", "legendFormat": "root %", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "thresholds": { "steps": [
        { "color": "green", "value": null },
        { "color": "yellow", "value": 70 },
        { "color": "red", "value": 85 }
      ]}}}
    }
  ],
  "schemaVersion": 39,
  "tags": ["zion", "mining", "pool"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "ZION V3 Pool Overview",
  "uid": "zion-v3-pool-overview"
}

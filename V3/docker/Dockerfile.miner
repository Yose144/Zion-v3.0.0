# ZION V3 Miner
# Multi-stage build for minimal production image
#
# Build:  docker build -f V3/docker/Dockerfile.miner -t zion-v3-miner .
# Run:    docker run -d --name zion-miner \
#           -e ZION_POOL_ADDR=zion-pool:8444 \
#           zion-v3-miner

FROM rust:1.85-bookworm AS builder
WORKDIR /build
RUN apt-get update && apt-get install -y \
        cmake g++ make pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*
COPY V3/ V3/
COPY Cargo.toml Cargo.lock* ./
RUN cargo build --release --manifest-path V3/Cargo.toml -p zion-miner --bin zion-miner

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y \
        ca-certificates libssl3 curl \
    && rm -rf /var/lib/apt/lists/*
RUN groupadd -r zion && useradd -r -g zion -d /home/zion -s /sbin/nologin -m zion
COPY --from=builder /build/V3/target/release/zion-miner /usr/local/bin/zion-miner

ENV ZION_POOL_ADDR=127.0.0.1:8444
ENV ZION_MINER_THREADS=1

USER zion
ENTRYPOINT ["zion-miner"]

# SimpleMining OS environment template for ZION V3 miner
# Copy to smos.env and fill your values.

# Required: payout wallet address (zion1...)
ZION_MINER_ID=zion1YOUR_WALLET_ADDRESS

# Optional: worker name shown in pool stats.
# If empty, script auto-uses rig_name from SMOS when available.
ZION_WORKER_NAME=

# Optional: pool endpoint. Defaults to Edge public pool (Core + Edge topology).
ZION_POOL_ADDR=62.171.141.136:8444

# Optional miner tuning
ZION_THREADS=0
ZION_PROFILE=pool
ZION_LOOP_COUNT=1
ZION_METRICS_REPORT_SECS=30
ZION_NONCE_AUTOTUNE=true
ZION_GPU_BACKEND=auto

# CUDA tuning (only when GPU backend resolves to CUDA)
ZION_CUDA_WORK_CAP=4096
ZION_CUDA_TPB=128

# Optional JSON stats output for external monitoring
# ZION_STATS_FILE=/var/log/miner_stats.json

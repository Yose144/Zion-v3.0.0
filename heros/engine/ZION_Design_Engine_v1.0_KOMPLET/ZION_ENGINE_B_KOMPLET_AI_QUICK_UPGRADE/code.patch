+}
+
+.description {
+  max-width: 62ch;
+  margin: 0.75rem auto 1.25rem;
+  line-height: 1.6;
+}
+
+.signature {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: center;
+  gap: 0.75rem;
+  margin: 1.25rem auto 0;
+}
+
+.heritage, .whale {
+  display: block;
+  height: auto;
+  max-width: 100%;
+  border-radius: 0.5rem;
+}
+
+.heritage {
+  width: 12.5rem;
+}
+
+.whale {
+  width: 7rem;
+  background: #f0e1be;
+}

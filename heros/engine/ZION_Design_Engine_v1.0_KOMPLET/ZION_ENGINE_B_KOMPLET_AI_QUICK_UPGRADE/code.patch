+  background: #0b100d;
+  color: #f0e1be;
+}
+
+.art {
+  display: block;
+  width: 100%;
+  height: auto;
+}
+
+.actions {
+  padding: clamp(1.25rem, 4vw, 2.5rem);
+  text-align: center;
+  background: linear-gradient(155deg, #34191c, #0b100d 45%, #123423);

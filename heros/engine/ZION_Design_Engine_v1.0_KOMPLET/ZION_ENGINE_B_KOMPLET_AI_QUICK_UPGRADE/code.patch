+export function designImage(src: string | undefined): string | undefined {
+  if (!src) return src;
+  const path = src.split('?')[0].replace(/^https:\/\/market\.zionterranova\.com/, '');
+  return paths.has(path) ? `${path}?v=engine-v1` : src;
+}

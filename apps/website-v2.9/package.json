{
  "name": "zion-web-v3.2.0",
  "version": "3.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "predev": "node scripts/gen-doc-manifest.mjs",
    "prebuild": "node scripts/gen-doc-manifest.mjs && npm run build -w zion-wallet-sdk",
    "build": "next build --webpack",
    "check:links": "node scripts/check-doc-links.mjs",
    "analyze": "ANALYZE=true next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "deploy": "bash scripts/deploy.sh",
    "docs:i18n": "node scripts/docs-i18n-report.mjs",
    "test:e2e:api": "bash scripts/e2e-miner-stats.sh",
    "test:e2e:api:local": "bash scripts/e2e-miner-stats.sh http://localhost:3000",
    "test:e2e:ui": "playwright test",
    "test:e2e:ui:prod": "E2E_BASE_URL=https://zionterranova.com playwright test",
    "test:e2e": "npm run test:e2e:api && npm run test:e2e:ui:prod"
  },
  "dependencies": {
    "@lifi/sdk": "4.0.1",
    "@lifi/widget": "4.1.0",
    "@lifi/widget-light": "4.1.0",
    "@noble/curves": "1.9.1",
    "@noble/ed25519": "3.1.0",
    "@noble/hashes": "2.3.0",
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.6.1",
    "@scure/bip39": "2.3.0",
    "@simplewebauthn/browser": "13.3.0",
    "@splinetool/react-spline": "^4.1.0",
    "@tailwindcss/typography": "^0.5.19",
    "clsx": "^2.1.1",
    "ethers": "^5.8.0",
    "framer-motion": "12.42.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.473.0",
    "next": "^16.4.3",
    "qrcode.react": "^4.2.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.1",
    "three": "^0.186.1",
    "viem": "2.57.11",
    "zion-wallet-sdk": "*"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.2.10",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "babel-plugin-react-compiler": "1.0.0",
    "baseline-browser-mapping": "2.11.33",
    "eslint": "9.39.4",
    "eslint-config-next": "16.0.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}

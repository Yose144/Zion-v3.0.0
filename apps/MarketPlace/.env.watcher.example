# ZION MarketPlace L1 Watcher — environment variables
# Copy to .env.watcher and fill in real values

# ── L1 (ZION native chain) ──────────────────────────────────────────
# RPC endpoint (raw TCP JSON-RPC). Use 127.0.0.1:9443 on Edge server,
# or rpc.zionterranova.com:8443 from remote.
L1_RPC_URL=127.0.0.1:9443

# Bridge vault address (where buyers send ZION for marketplace purchases)
L1_BRIDGE_VAULT=zion1j53677g5k83030x3s2z2z644e7h07792q0u02t7

# Finality: number of L1 blocks to wait before settling on L2
L1_FINALITY_BLOCKS=60

# Poll interval (seconds)
L1_POLL_INTERVAL_S=15

# Start scanning from this height (omit to resume from saved state)
# L1_START_HEIGHT=25000

# Migration height for amount scaling (0 = already 1e6 scale on this chain)
L1_SCALE_FIX_HEIGHT=0

# ── L2 (Base Mainnet) ───────────────────────────────────────────────
# Base RPC URL
L2_RPC_URL=https://mainnet.base.org

# ZIONMarketplace contract address on Base (set after deployment)
L2_MARKETPLACE_ADDR=

# Relayer private key (must have RELAYER_ROLE on the marketplace contract)
# Generate a dedicated key for this — do NOT reuse the bridge relayer key
L2_RELAYER_PRIV_KEY=

# ── SHOPPAY shop payments (customer ZION transfers with memo) ─────────
# Shop receiving address — where customers send ZION for orders
L1_SHOP_VAULT=zion1n4k4n5e4p0z3g7z2e0z0j7c8w7y0v5m8c6hf8c2

# Where to POST confirmed shop payments (the marketplace app itself)
SHOP_CONFIRM_URL=http://127.0.0.1:3100/api/shop/zion-confirm

# Shared secret — must match SHOP_CONFIRM_SECRET in the app .env
SHOP_CONFIRM_SECRET=

# Blocks before a SHOPPAY tx counts as final (shorter than L2 settlement)
SHOP_FINALITY_BLOCKS=15

// Lumi — samostatný e-shop Omnity.One s.r.o.
// SQLite: vlastní databáze, oddělená od ZION MarketPlace (jiná značka, jiný provoz).
//
// `output` je záměrně MIMO výchozí `node_modules/.prisma`: v monorepu sdílíme
// jeden `node_modules`, takže generováním do defaultu by Lumi přepsalo Prisma
// klienta MarketPlace (a naopak). Vlastní output = dva klienti vedle sebe.

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Prodejní data produktu. Obsah (jména, popisy, fotky) drží `src/data/catalog.ts`,
/// databáze nese jen to, co má jít měnit bez deploye: cena, sklad, aktivita.
model Product {
  id          String   @id @default(cuid())
  externalId  String   @unique
  priceCzk    Int
  oldPriceCzk Int?
  stock       Int      @default(0)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
}

model Order {
  id             String  @id @default(cuid())
  orderId        String  @unique
  status         String  @default("pending") // pending | paid | processing | shipped | completed | cancelled
  paymentStatus  String  @default("pending") // pending | paid | failed | refunded
  customerName   String
  customerEmail  String
  customerPhone  String
  /// Jazyk, ve kterém zákazník objednal (cs | en | de) — e-maily a faktura.
  lang           String  @default("cs")
  shipping       String // zasilkovna | zasilkovna-home | osobni-odber
  payment        String // transfer | card | cod
  addressStreet  String?
  addressCity    String?
  addressZip     String?
  pickupPoint    String?
  note           String?
  companyName    String?
  buyerIco       String?
  buyerDic       String?
  /// JSON pole řádků: [{ externalId, slug, name, quantity, unitPriceCzk, lineTotalCzk, personalization? }]
  items          String
  subtotalCzk    Int
  shippingCzk    Int     @default(0)
  codCzk         Int     @default(0)
  totalCzk       Int
  variableSymbol String?
  invoiceNumber  String?
  // Bezpečnostní prohlášení u zboží s otevřeným plamenem.
  fireConsentName    String?
  fireConsentAt      DateTime?
  fireConsentVersion String?
  termsAccepted  Boolean @default(false)
  newsletter     Boolean @default(false)
  trackingNumber String?
  shippedAt      DateTime?
  paidAt         DateTime?
  /// JSON historie stavů: [{ status, at, by, note? }]
  statusHistory  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([paymentStatus])
  @@index([customerEmail])
  @@index([createdAt])
}

/// Poptávka z B2B stránek (svatby / firmy) nebo z kontaktního formuláře.
model Inquiry {
  id        String   @id @default(cuid())
  type      String   @default("contact") // svatba | firma | kontakt
  name      String
  email     String
  phone     String?
  company   String?
  eventDate String?
  quantity  Int?
  message   String
  status    String   @default("new") // new | contacted | won | lost
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  lang      String   @default("cs")
  source    String?
  createdAt DateTime @default(now())
}

/// Klíč/hodnota pro číselnou řadu faktur a drobná nastavení.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

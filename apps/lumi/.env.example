# ── Lumi — konfigurace ────────────────────────────────────────────────
# Zkopíruj na .env (nikdy necommituj skutečný soubor).
# Všechny hodnoty jsou volitelné; bez nich web jede v režimu „převod + dobírka“.

# Veřejná adresa (kanonická URL, OG obrázky, odkazy v e-mailech).
NEXT_PUBLIC_SITE_URL=https://lumi.zionterranova.com

# SQLite. **Používej absolutní cestu** — Prisma CLI i runtime resolvují
# relativní cestu od jiného místa (CLI od schématu, server od cwd) a vznikne
# prázdná databáze. Produkce: file:/opt/zion/data/lumi/lumi.db
# Lokálně např.: file:/Users/vas/projekty/2.9.6/apps/lumi/prisma/lumi.db
DATABASE_URL=file:/opt/zion/data/lumi/lumi.db

# ── Admin ─────────────────────────────────────────────────────────────
# Uživatelské jméno a heslo do /admin. Bez hesla je admin vypnutý (fail-closed).
LUMI_ADMIN_USER=admin
LUMI_ADMIN_PASSWORD=
# Náhodný 32+ znaků — podepisuje session cookie.
LUMI_SESSION_SECRET=
# Token pro první naplnění katalogu (POST /api/seed, Bearer).
LUMI_SEED_TOKEN=

# ── Platby ────────────────────────────────────────────────────────────
# Bankovní převod (primární, vždy zapnutý).
LUMI_BANK_ACCOUNT=2901809148/2010
LUMI_BANK_IBAN=CZ6320100000002901809148
LUMI_BANK_BIC=FIOBCZPPXXX
LUMI_BANK_NAME=Fio banka, a.s.
LUMI_BANK_OWNER=Omnity.One s.r.o.

# Stripe karta (volitelné). Bez klíčů se karta v pokladně nenabízí.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Dobírka — příplatek v Kč (0 = dobírka vypnutá).
LUMI_COD_FEE_CZK=45

# Doprava zdarma od (Kč, 0 = vypnuto).
LUMI_FREE_SHIPPING_FROM=1500

# ── E-maily ───────────────────────────────────────────────────────────
# SMTP. Bez SMTP se e-maily jen zalogují (objednávka se neztratí).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=0
LUMI_EMAIL_FROM=Lumi <objednavky@lumi.zionterranova.com>
LUMI_EMAIL_REPLY_TO=ahoj@lumi.zionterranova.com
LUMI_ADMIN_EMAIL=ahoj@lumi.zionterranova.com
# Volitelné — bez hodnoty se telefon na webu vůbec nezobrazí.
LUMI_PHONE=

# ── Fakturace ─────────────────────────────────────────────────────────
LUMI_INVOICE_PREFIX=LF
LUMI_INVOICE_DUE_DAYS=7

# ── Provoz ────────────────────────────────────────────────────────────
# Výchozí jazyk (cs | en | de) — jen pro serverový SEO metadata.
LUMI_DEFAULT_LANG=cs
# Objednávky do tohoto data stíháme doručit před Vánoci (ISO, volitelné).
LUMI_CHRISTMAS_CUTOFF=2026-12-10

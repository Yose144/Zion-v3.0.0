{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Capability for the main dashboard window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "bash", "cmd": "bash", "args": true },
        { "name": "ls", "cmd": "ls", "args": true },
        { "name": "tail", "cmd": "tail", "args": true },
        { "name": "find", "cmd": "find", "args": true },
        { "name": "stat", "cmd": "stat", "args": true },
        { "name": "du", "cmd": "du", "args": true },
        { "name": "systemctl", "cmd": "systemctl", "args": true }
      ]
    }
  ]
}

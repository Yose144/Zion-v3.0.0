[Unit]
Description=ZION V3 Node - P2P sync, consensus, mempool, RPC
Documentation=https://github.com/Yose144/Zion-v3.0.0/blob/main/ZION_OS/README.md
After=network.target
Wants=network.target

[Service]
Type=simple
User=zion
Group=zion
WorkingDirectory=/opt/zion

Environment=ZION_NODE_ID=local-node
Environment=ZION_P2P_BIND=0.0.0.0:8333
Environment=ZION_RPC_BIND=0.0.0.0:8443
Environment=ZION_NODE_STATE_PATH=/opt/zion/data/zion-node-state.db
Environment=ZION_MINER_ADDRESS=zion1w523a76830x2t5m7f3j023w265e8g5c400a4790
Environment=ZION_HUMANITARIAN_WALLET=zion165a527w5d0n085t775x3w8n8q20742a6w7xr0z3
Environment=ZION_ISSOBELLA_WALLET=zion140n8a8t6f3083232r0g6c498r6c0d423f4h9702
Environment=ZION_SEED_PEERS=77.42.71.94:8333

ExecStart=/opt/zion/V3/target/release/node
ExecStop=/bin/kill -TERM $MAINPID
ExecReload=/bin/kill -HUP $MAINPID

Restart=on-failure
RestartSec=5
StartLimitInterval=60
StartLimitBurst=3

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

# Security
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/zion/data /opt/zion/logs

StandardOutput=append:/opt/zion/logs/node.log
StandardError=append:/opt/zion/logs/node.log
SyslogIdentifier=zion-node

[Install]
WantedBy=multi-user.target

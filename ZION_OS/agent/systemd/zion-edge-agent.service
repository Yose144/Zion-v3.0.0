[Unit]
Description=ZION OS Agent (Edge CPU-only)
After=network-online.target zion-edge-node1.service zion-edge-pool.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/zion-agent
Restart=always
RestartSec=10
User=root

# Working dir for config
WorkingDirectory=/root/zion-2.9.6-main

# Env
Environment="RUST_LOG=info"
Environment="ZION_CONFIG_DIR=/root/zion-2.9.6-main/ZION_OS/agent/config"

[Install]
WantedBy=multi-user.target

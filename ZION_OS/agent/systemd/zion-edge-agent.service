[Unit]
Description=ZION OS Agent (Edge CPU-only)
After=network-online.target zion-edge-node1.service zion-edge-pool.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/zion-agent
Restart=always
RestartSec=10
User=zion
Group=zion

# Working dir for config
WorkingDirectory=/opt/zion

# Env
EnvironmentFile=/etc/zion/edge-environment.sh
Environment="RUST_LOG=info"
Environment="AGENT_CONFIG=/opt/zion/ZION_OS/agent/config/edge-agent.toml"
Environment="AGENT_API_BIND=127.0.0.1:8767"

# Security hardening (unprivileged zion user)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=yes
ReadWritePaths=/data/zion /opt/zion/data /opt/zion/logs /var/log/zion /opt/zion/ZION_OS/agent/config
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target

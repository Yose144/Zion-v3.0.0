[Unit]
Description=ZION V3 Mainnet Launch Dashboard
After=network.target

[Service]
Type=simple
User=yeshuae
WorkingDirectory=/Users/yeshuae/Projects/2.9.6/dashboard
ExecStart=/bin/bash /Users/yeshuae/Projects/2.9.6/dashboard/Ubuntu/start-dashboard-ubuntu.sh
Restart=always
RestartSec=10

# Logging
StandardOutput=append:/Users/yeshuae/Projects/2.9.6/logs/dashboard-systemd.log
StandardError=append:/Users/yeshuae/Projects/2.9.6/logs/dashboard-systemd.err

# Environment
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin

[Install]
WantedBy=multi-user.target

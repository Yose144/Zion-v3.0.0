# ZION dashboard — secrets for services.json
# Copy to dashboard/.env (gitignored) and fill in real values.
# The dashboard backend loads this file at startup and substitutes ${VAR}
# placeholders in services.json. Unresolved placeholders are omitted, so the
# target binary falls back to its own default (or fails loudly if required).

# Dashboard Basic Auth users (comma-separated "user:sha256hex" pairs).
# Generate a hash with: python3 -c "import hashlib; print(hashlib.sha256(b'password').hexdigest())"
# REQUIRED when the dashboard is exposed to the internet.
DASHBOARD_USERS=

# Pool payout signing key (hex). REQUIRED for the pool to pay out shares.
ZION_POOL_PAYOUT_SK_HEX=

# DAO admin API key (optional — protects mutating DAO endpoints).
ZION_DAO_API_KEY=

# L2 Bridge — premium RPC + validator key (required for bridge relayer).
ANKR_API_KEY=
ZION_VALIDATOR_PRIVATE_KEY=

# L2 Atomic Swap — node RPC token + HTLC escrow key.
ZION_RPC_TOKEN=
ZION_SWAP_ESCROW_KEY=

# ── AuxPow / external-pool switching (used by zion-edge-pool.service) ─────────
# These are managed by the dashboard "External Pool Switching" panel on the
# Revenue tab. They live in edge-deploy/config/edge-environment.sh on the Edge
# server so the pool picks them up after a restart.
#
# ZION_POOL_AUXPOW_ENABLED=1          # 1/true/yes to enable external jobs
# ZION_POOL_AUXPOW_COIN=KAS            # force a coin (DCR/ALPH/KAS/ERG/RVN/ETC/EVR/MEWC/FLUX/CLORE/XMR)
# ZION_POOL_AUXPOW_POOL_PREFERENCE=default  # default | nicehash | herominers | zpool
# ZION_POOL_AUXPOW_REGION=eu           # geographic region for pool selection
# ZION_POOL_AUXPOW_SPLIT_ZION=50       # weight of ZION jobs (0-100)
# ZION_POOL_AUXPOW_SPLIT_EXTERNAL=50   # weight of external jobs (0-100)
# ZION_POOL_AUXPOW_WALLET=bc1q...      # default BTC payout wallet
# ZION_POOL_AUXPOW_WORKER_NAME=zion_auxpow
# ZION_POOL_AUXPOW_WALLET_KAS=kas:...  # per-coin payout overrides (optional)

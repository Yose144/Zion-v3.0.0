[Unit]
Description=ZION OS Orchestrator - Service health monitoring and auto-restart
Documentation=https://github.com/Yose144/Zion-v3.0.0/blob/main/ZION_OS/README.md
After=zion-node.service zion-pool.service zion-dashboard-web.service

[Service]
Type=simple
User=zion
Group=zion
WorkingDirectory=/opt/zion/ZION_OS/orchestrator

Environment=PYTHONPATH=/opt/zion/ZION_OS/orchestrator
Environment=ZION_MANIFEST_PATH=/opt/zion/ZION_OS/orchestrator/manifest.yaml

ExecStart=/usr/bin/python3 /opt/zion/ZION_OS/orchestrator/orchestrator.py watch --interval 30
ExecStop=/bin/kill -TERM $MAINPID

Restart=on-failure
RestartSec=10
StartLimitInterval=60
StartLimitBurst=3

LimitNOFILE=65536

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/zion/logs

StandardOutput=append:/opt/zion/logs/orchestrator.log
StandardError=append:/opt/zion/logs/orchestrator.log
SyslogIdentifier=zion-orchestrator

[Install]
WantedBy=multi-user.target

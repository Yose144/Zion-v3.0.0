[Unit]
Description=ZION Desktop Agent (Electron mining agent)
Documentation=file:///home/zionserver/2.9.6-main/AGENTS.md
# Start only once a graphical session exists (DISPLAY/WAYLAND_DISPLAY/
# XAUTHORITY are imported into the user manager by gnome-session).
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# Best-effort wait for DNS at early boot — remote iframes (market/oasis) and
# https endpoints otherwise race NetworkManager/resolved. Never blocks start.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do getent hosts zionterranova.com >/dev/null 2>&1 && exit 0; sleep 2; done; exit 0'
ExecStart=%h/bin/start-desktop-agent.sh
Restart=on-failure
RestartSec=15

[Install]
WantedBy=graphical-session.target

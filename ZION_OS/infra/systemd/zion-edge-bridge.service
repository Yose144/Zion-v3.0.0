[Unit]
Description=ZION Edge Bridge (L2 Cross-Chain Relay)
After=network-online.target zion-edge-node1.service
Wants=network-online.target
Requires=zion-edge-node1.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/zion-2.9.6-main
EnvironmentFile=/root/zion-2.9.6-main/edge-deploy/config/edge-environment.sh
Environment="ZION_NODE_RPC_ADDR=127.0.0.1:8443"
Environment="BRIDGE_API_BIND=0.0.0.0:8451"
Environment="BRIDGE_METRICS_BIND=0.0.0.0:9102"
Environment="RUST_LOG=info,zion_bridge=debug"
ExecStart=/root/zion-2.9.6-main/V3/target/release/zion-bridge --config /root/zion-2.9.6-main/V3/L2/bridge/config/bridge-mainnet.toml
Restart=always
RestartSec=10
KillMode=process
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

# Security hardening (relax as needed)
NoNewPrivileges=false
ProtectSystem=false
ProtectHome=false

[Install]
WantedBy=multi-user.target

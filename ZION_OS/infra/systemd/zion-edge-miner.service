[Unit]
Description=ZION Edge Miner (CPU 2-core continuous)
After=network.target zion-edge-pool.service
Requires=zion-edge-pool.service

[Service]
Type=simple
User=root
Environment="ZION_INTERACTIVE=false"
Environment="ZION_MINER_ID=edge-primary"
ExecStart=/usr/local/bin/zion-miner --pool 127.0.0.1:8444 --threads 2 --worker edge-miner-1 --wallet zion16825y2v5f3q507e5c2e0j8n666z43558l3zt604 --algorithm deeksha_lite_v1 --loops 1000000 --gpu cpu
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

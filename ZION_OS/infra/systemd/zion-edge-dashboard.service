[Unit]
Description=ZionOS Dashboard (Unified Infrastructure View)
After=network-online.target zion-edge-node1.service zion-edge-pool.service zion-edge-dao.service zion-edge-warp.service zion-edge-agent.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/zion-2.9.6-main/ZION_OS/dashboard/infra
Environment="RUST_LOG=info"
Environment="ZIONOS_BIND=0.0.0.0:8888"
Environment="ZIONOS_NODE_RPC=http://127.0.0.1:8443"
Environment="ZIONOS_POOL_METRICS=http://127.0.0.1:8444"
Environment="ZIONOS_DAO_API=http://127.0.0.1:8450"
Environment="ZIONOS_WARP_API=http://127.0.0.1:8453"
Environment="ZIONOS_AGENT_API=http://127.0.0.1:8767"
ExecStart=/usr/local/bin/zionos-dashboard
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target

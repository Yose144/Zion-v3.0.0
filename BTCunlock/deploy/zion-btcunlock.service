[Unit]
Description=BTCunlock lottery worker (coordinator-leased keyscan units)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust paths: WorkingDirectory = BTCunlock checkout with a built
# target/release/btcunlock; EnvironmentFile holds COORD_URL + TOKEN
# (mode 600 — it carries the shared write token).
WorkingDirectory=/home/zionserver/2.9.6-main/BTCunlock
EnvironmentFile=/home/zionserver/btcunlock/coord.env
ExecStart=/usr/bin/python3 btcunlock-worker.py --gpu --stride 16 --batch 262144 --worker-id dest-zion --label "GTX 1070 Ti"
Restart=always
RestartSec=15
Nice=15
# Daily restart bounds log growth; a mid-unit restart just lets the
# lease expire and the unit returns to the pool.
RuntimeMaxSec=86400
StandardOutput=append:/home/zionserver/btcunlock/worker.log
StandardError=append:/home/zionserver/btcunlock/worker.log

[Install]
WantedBy=default.target

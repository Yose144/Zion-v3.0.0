# ═══════════════════════════════════════════════════════════════
# ZION GPU Revenue Stack — Environment Variables
# Kopíruj jako .env a vyplň před deploy
# ═══════════════════════════════════════════════════════════════

# ── Wallet (BTC payout přes 2miners/MoneroOcean) ──────────────
ZION_BTC_WALLET=bc1qvujra09wlsm35tmhc0v0fnxpsj0cuaq88hd8mw

# ── Worker jméno (pro identifikaci v pool dashboardu) ─────────
ZION_WORKER=zion_gpu_1

# ── Coin (auto = profit-switcher rozhodne, nebo ERG/RVN/ETC/ALPH/KAS)
ZION_GPU_COIN=auto
ZION_GPU_ALGO=autolykos2

# ── Pool (override pokud nechceš auto) ───────────────────────
# ERG:  erg.2miners.com:8008
# RVN:  rvn.2miners.com:6060
# ETC:  etc.2miners.com:1010
# ALPH: alph.2miners.com:1199
# KAS:  pool.woolypooly.com:3112
ZION_GPU_POOL=erg.2miners.com:8008

# ── WhatToMine GPU ID (pro profit switching) ─────────────────
# 353 = RTX 4090  |  165 = RTX 3080  |  74 = RTX 3070
# 335 = RX 7900 XT|  141 = RX 6800   |  120 = RX 5700 XT
WHATTOMINE_GPU_ID=353

# ── NCL Gateway ───────────────────────────────────────────────
ZION_POOL_URL=http://77.42.31.72:8444
NCL_GPU_ENABLED=1

# ── GPU detection ──────────────────────────────────────────────
# 1 = has GPU, 0 = CPU only
ZION_HAS_GPU=1

# ZION V3 AI Native Runtime

FROM rust:1.85-bookworm AS builder
WORKDIR /build
RUN apt-get update && apt-get install -y pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*
COPY . .
RUN cargo build --release -p zion-ai-native --bin zion-ai-native-api

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y ca-certificates curl libssl3 && rm -rf /var/lib/apt/lists/*
RUN groupadd -r zion && useradd -r -g zion -d /home/zion -s /usr/sbin/nologin zion
COPY --from=builder /build/target/release/zion-ai-native-api /usr/local/bin/zion-ai-native-api
USER zion
EXPOSE 8001
ENTRYPOINT ["zion-ai-native-api"]
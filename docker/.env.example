# ╔════════════════════════════════════════════════════════════════╗
# ║  ZION TerraNova v2.9.8 — Production Environment Template    ║
# ╚════════════════════════════════════════════════════════════════╝
#
# Copy this file to .env and fill in ALL required values.
# NEVER commit .env to git (it's in .gitignore).
#
# P1-32: All passwords MUST be set — no hardcoded defaults.

# ─── Redis ───
# Required by: pool, monitoring redis-exporter
REDIS_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD

# ─── Grafana ───
# Required by: monitoring stack
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD

# ─── Pool ───
# ZION wallet address for pool payouts (REQUIRED for mainnet)
ZION_POOL_WALLET=zion1YOUR_MAINNET_ADDRESS_HERE
MINER_WALLET=zion1YOUR_MINER_ADDRESS_HERE
MINER_WORKER=default

# ─── Testnet Seed Peers ───
SEED_PEERS=91.98.122.165:8334

# ─── Ankr (EVM RPC backend pro bridge + WARP) ───
# Získáš na https://ankr.com → Dashboard → RPC Service → My Endpoints
ANKR_API_KEY=d036dcf6e89c08c7a36d0b2d723d2d8ac27090965fa5925f60cab30b9c02f152

# ─── Discord Webhooks (Alertmanager) ───
DISCORD_WEBHOOK_OPS=https://discord.com/api/webhooks/CHANGE_ME
DISCORD_WEBHOOK_CRITICAL=https://discord.com/api/webhooks/CHANGE_ME

# ─── SMTP (for email notifications) ───
SMTP_PASSWORD=

# ─── Website ───
ADMIN_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
CORS_ORIGIN=https://zionterranova.com

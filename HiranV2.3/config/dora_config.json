{
  "version": "2.3",
  "description": "DORA (Weight-Decomposed Low-Rank Adaptation) configuration for Hiran v2.3",
  "base_model": "nvidia/OpenReasoning-Nemotron-32B",
  "method": "DORA",
  "quantization": {
    "load_in_8bit": true,
    "bnb_8bit_use_double_quant": true,
    "bnb_8bit_quant_type": "nf4",
    "bnb_8bit_compute_dtype": "bfloat16"
  },
  "dora": {
    "use_dora": true,
    "use_rslora": true,
    "target_modules": "all-linear",
    "init_lora_weights": "gaussian"
  },
  "training": {
    "bf16": true,
    "gradient_checkpointing": true,
    "optim": "adamw_8bit",
    "group_by_length": true,
    "max_seq_length": 2048
  },
  "stages": [
    {
      "name": "stage1_factual",
      "rank": 512,
      "alpha": 362,
      "alpha_formula": "rank^0.5 * 16",
      "dropout": 0.05,
      "epochs": 5,
      "learning_rate": 1e-4,
      "batch_size": 1,
      "gradient_accumulation_steps": 16,
      "warmup_steps": 500,
      "weight_decay": 0.01,
      "lr_scheduler": "cosine_with_restarts",
      "dataset": "data/curriculum/stage1_factual_reinforcement.jsonl",
      "goal": "Memorize exact facts: fee split 89/5/5/1, 7 categories, L1-L6, Issobella 5%"
    },
    {
      "name": "stage2_domain",
      "rank": 512,
      "alpha": 362,
      "dropout": 0.03,
      "epochs": 3,
      "learning_rate": 5e-5,
      "batch_size": 1,
      "gradient_accumulation_steps": 16,
      "warmup_steps": 300,
      "weight_decay": 0.01,
      "lr_scheduler": "cosine",
      "dataset": "data/curriculum/stage2_domain_expertise.jsonl",
      "continue_from": "checkpoints/stage1_factual/final",
      "goal": "Deep domain expertise in mining, DAO, bridges, consensus, security"
    },
    {
      "name": "stage3_cross",
      "rank": 512,
      "alpha": 362,
      "dropout": 0.02,
      "epochs": 2,
      "learning_rate": 2e-5,
      "batch_size": 1,
      "gradient_accumulation_steps": 16,
      "warmup_steps": 200,
      "weight_decay": 0.01,
      "lr_scheduler": "cosine",
      "dataset": "data/curriculum/stage3_cross_domain.jsonl",
      "continue_from": "checkpoints/stage2_domain/final",
      "goal": "Cross-domain synthesis and technical comparisons"
    }
  ],
  "hardware_requirements": {
    "minimum_gpu": "1x A100 80GB",
    "recommended_gpu": "2x A100 80GB (DeepSpeed ZeRO-3)",
    "estimated_vram": "~60-70GB with 8-bit quantization",
    "estimated_training_time": "48-72 hours on 1x A100 80GB",
    "estimated_cost_vast_ai": "$150-250 (1x A100 80GB) or $300-500 (2x A100 80GB)"
  },
  "success_criteria": {
    "factual_recall_fee_split": ">95% exact at temperature 0.1",
    "factual_recall_categories": ">99% exact",
    "no_religious_contamination": "true at all temperatures",
    "adversarial_safety": "refuses attack assistance",
    "inference_speed_fp16": ">25 tok/s on A100",
    "inference_speed_gguf": ">50 tok/s on RTX 4090"
  }
}

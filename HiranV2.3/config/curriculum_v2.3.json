{
  "description": "Curriculum configuration for Hiran v2.3 - Full Quantized AI Agent",
  "base_model": "nvidia/OpenReasoning-Nemotron-32B",
  "model_size": "32B",
  "training_strategy": "hybrid_lora_full_finetune",
  "quantization_target": ["int8", "int4"],
  "stages": [
    {
      "name": "foundation_domain_adaptation",
      "description": "Base model adaptation to Zion domain and general knowledge",
      "rank": 128,
      "alpha": 256,
      "dropout": 0.05,
      "epochs": 2,
      "learning_rate": 1e-5,
      "batch_size": 2,
      "gradient_accumulation_steps": 8,
      "target_modules": ["q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj"],
      "dataset": "foundation_domain.jsonl",
      "max_steps": 1000,
      "warmup_steps": 100,
      "logging_steps": 10,
      "save_steps": 100,
      "eval_steps": 200,
      "dataset_size": "100M tokens",
      "expected_duration": "24-36 hours"
    },
    {
      "name": "zion_gaming_mastery",
      "description": "Deep Zion Oasis expertise - blueprint construction, game mechanics, balance",
      "rank": 128,
      "alpha": 256,
      "dropout": 0.05,
      "epochs": 3,
      "learning_rate": 5e-5,
      "batch_size": 2,
      "gradient_accumulation_steps": 8,
      "target_modules": ["all"],
      "dataset": "zion_gaming_mastery.jsonl",
      "max_steps": 1500,
      "warmup_steps": 150,
      "logging_steps": 10,
      "save_steps": 150,
      "eval_steps": 300,
      "dataset_size": "50M tokens",
      "expected_duration": "36-48 hours"
    },
    {
      "name": "programming_excellence",
      "description": "Advanced programming - smart contracts, game dev, automation",
      "rank": 128,
      "alpha": 256,
      "dropout": 0.03,
      "epochs": 2,
      "learning_rate": 5e-5,
      "batch_size": 2,
      "gradient_accumulation_steps": 8,
      "target_modules": ["all"],
      "dataset": "programming_excellence.jsonl",
      "max_steps": 1200,
      "warmup_steps": 120,
      "logging_steps": 10,
      "save_steps": 120,
      "eval_steps": 240,
      "dataset_size": "80M tokens",
      "expected_duration": "24-36 hours"
    },
    {
      "name": "web_browsing_agent",
      "description": "Web browsing, information retrieval, fact verification",
      "rank": 128,
      "alpha": 256,
      "dropout": 0.03,
      "epochs": 2,
      "learning_rate": 3e-5,
      "batch_size": 2,
      "gradient_accumulation_steps": 8,
      "target_modules": ["all"],
      "dataset": "web_browsing_agent.jsonl",
      "max_steps": 1000,
      "warmup_steps": 100,
      "logging_steps": 10,
      "save_steps": 100,
      "eval_steps": 200,
      "dataset_size": "30M tokens",
      "expected_duration": "20-30 hours"
    },
    {
      "name": "tool_orchestration",
      "description": "Multi-tool coordination, complex task execution, error handling",
      "rank": 256,
      "alpha": 512,
      "dropout": 0.02,
      "epochs": 2,
      "learning_rate": 2e-5,
      "batch_size": 1,
      "gradient_accumulation_steps": 16,
      "target_modules": ["all"],
      "dataset": "tool_orchestration.jsonl",
      "max_steps": 800,
      "warmup_steps": 80,
      "logging_steps": 10,
      "save_steps": 80,
      "eval_steps": 160,
      "dataset_size": "20M tokens",
      "expected_duration": "24-32 hours"
    },
    {
      "name": "rag_integration",
      "description": "RAG-aware training, context injection, synthesis capability",
      "rank": 256,
      "alpha": 512,
      "dropout": 0.02,
      "epochs": 1,
      "learning_rate": 1e-5,
      "batch_size": 1,
      "gradient_accumulation_steps": 16,
      "target_modules": ["all"],
      "dataset": "rag_integration.jsonl",
      "max_steps": 600,
      "warmup_steps": 60,
      "logging_steps": 10,
      "save_steps": 60,
      "eval_steps": 120,
      "dataset_size": "15M tokens",
      "expected_duration": "16-20 hours"
    },
    {
      "name": "cross_domain_synthesis",
      "description": "Multi-domain reasoning, knowledge transfer, general capability",
      "rank": 256,
      "alpha": 512,
      "dropout": 0.01,
      "epochs": 1,
      "learning_rate": 5e-6,
      "batch_size": 1,
      "gradient_accumulation_steps": 16,
      "target_modules": ["all"],
      "dataset": "cross_domain_synthesis.jsonl",
      "max_steps": 500,
      "warmup_steps": 50,
      "logging_steps": 10,
      "save_steps": 50,
      "eval_steps": 100,
      "dataset_size": "20M tokens",
      "expected_duration": "12-16 hours"
    }
  ],
  "training_config": {
    "framework": "deepspeed",
    "deepspeed_config": "config/deepspeed_config.json",
    "fp16": true,
    "bf16": true,
    "gradient_checkpointing": true,
    "gradient_clipping": 1.0,
    "weight_decay": 0.01,
    "adam_beta1": 0.9,
    "adam_beta2": 0.999,
    "adam_epsilon": 1e-8,
    "max_grad_norm": 1.0,
    "lr_scheduler_type": "cosine",
    "warmup_ratio": 0.1
  },
  "hardware_requirements": {
    "training": {
      "gpu_type": ["H100", "A100"],
      "gpu_memory": "80GB",
      "gpu_count": "4-8",
      "system_ram": "512GB+",
      "storage": "2TB+ NVMe",
      "network": "100Gbps"
    },
    "production": {
      "gpu_type": ["RTX 4090", "A5000", "A6000"],
      "gpu_memory": "24-48GB",
      "system_ram": "64-128GB",
      "storage": "1TB+ SSD"
    }
  },
  "evaluation_config": {
    "benchmarks": [
      "HumanEval",
      "MBPP",
      "WebQSP",
      "MMLU",
      "GSM8K",
      "Zion_Blueprint_Quality",
      "Code_Generation_Accuracy",
      "Web_Retrieval_Accuracy"
    ],
    "domain_specific_tests": [
      "blueprint_generation",
      "game_mechanics",
      "balance_optimization",
      "smart_contract_dev",
      "tool_orchestration",
      "rag_effectiveness"
    ],
    "performance_targets": {
      "blueprint_quality": 0.85,
      "code_generation": 0.80,
      "web_retrieval": 0.90,
      "overall_latency_p50": 2.0,
      "overall_latency_p95": 5.0
    }
  },
  "deployment_config": {
    "quantization_levels": ["int8", "int4"],
    "target_platforms": ["docker", "kubernetes"],
    "api_compatibility": ["openai"],
    "model_size_targets": {
      "int8": "70GB",
      "int4": "35GB"
    },
    "inference_backends": ["vllm", "tensorrt_llm"],
    "vector_databases": ["chromadb", "weaviate"],
    "monitoring": ["prometheus", "grafana", "tensorboard"]
  },
  "tools_config": {
    "web_browsing": {
      "engine": "playwright",
      "capabilities": ["search", "navigate", "extract", "verify"]
    },
    "code_execution": {
      "engine": "docker",
      "capabilities": ["execute", "test", "debug", "analyze"]
    },
    "file_operations": {
      "engine": "virtual_fs",
      "capabilities": ["read", "write", "edit", "analyze"]
    },
    "api_integration": {
      "engine": "http_client",
      "capabilities": ["call_apis", "webhooks", "data_sync"]
    },
    "blueprint_generator": {
      "engine": "zion_specific",
      "capabilities": ["generate", "optimize", "balance", "design"]
    }
  },
  "rag_config": {
    "vector_db": "chromadb",
    "embedding_model": "text-embedding-3-large",
    "chunking_strategy": "semantic_chunking",
    "chunk_size": 512,
    "chunk_overlap": 128,
    "retrieval_top_k": 10,
    "reranking": "cross_encoder",
    "max_context_tokens": 8192,
    "document_sources": [
      "zion_documentation",
      "gaming_wiki",
      "code_repositories",
      "web_crawled_content"
    ]
  },
  "metadata": {
    "version": "2.3",
    "created": "2026-05-13",
    "author": "Hiran Development Team",
    "purpose": "Full quantized AI agent for Zion Oasis and general capabilities",
    "estimated_cost": "$2000-3000 (training) + $100-500/month (production)",
    "estimated_timeline": "16 weeks"
  }
}

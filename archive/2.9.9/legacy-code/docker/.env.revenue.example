# ═══════════════════════════════════════════
# ZION Revenue Stack — Environment Variables
# Zkopírovat jako .env.revenue a vyplnit!
# ═══════════════════════════════════════════

# ─── DERO (AstroBWTv3) ────────────────────
# Wallet: vytvořit přes dero-wallet-cli
# Docs: https://docs.dero.io/
DERO_WALLET=dero1qy...CHANGE_ME
DERO_CPUSET=14-15

# ─── ZEPH (RandomX) — pouze Helsinki ─────
# Wallet: vytvořit přes zephyr-wallet-cli
# Docs: https://www.zephyrprotocol.com/
ZEPH_WALLET=Zephyr...CHANGE_ME
ZEPH_CPUSET=12

# ─── EPIC (RandomX) — pouze Germany ──────
# Wallet: vytvořit přes epic-wallet
# Docs: https://epiccash.com/
EPIC_WALLET=http://...CHANGE_ME
EPIC_CPUSET=12

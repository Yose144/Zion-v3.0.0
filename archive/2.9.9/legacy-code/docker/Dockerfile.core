# ZION Core Node
# Multi-stage build for minimal production image

FROM rust:1.85-bookworm AS builder
ARG FEATURES=""
WORKDIR /build
RUN apt-get update && apt-get install -y cmake g++ make pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*
COPY . .
RUN if [ -n "$FEATURES" ]; then \
      cargo build --release -p zion-core --features "$FEATURES"; \
    else \
      cargo build --release -p zion-core; \
    fi

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y ca-certificates libssl3 curl && rm -rf /var/lib/apt/lists/*
RUN groupadd -r zion && useradd -r -g zion -d /data/zion -s /sbin/nologin zion
COPY --from=builder /build/target/release/zion-core /usr/local/bin/
RUN mkdir -p /data/zion && chown -R zion:zion /data/zion
ENV ZION_DATA_DIR=/data/zion
WORKDIR /data/zion
EXPOSE 8334 8444
VOLUME ["/data/zion"]
USER zion
ENTRYPOINT ["zion-core"]
CMD ["--data-dir", "/data/zion"]

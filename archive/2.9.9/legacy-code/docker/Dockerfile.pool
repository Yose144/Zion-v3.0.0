# ZION Mining Pool — V3 workspace build
# Builds the V3 pool server binary from V3/L1/pool (stratum v2 + revenue routing).

FROM rust:1.85-bookworm AS builder
ARG FEATURES="testnet"
WORKDIR /build
RUN apt-get update && apt-get install -y \
        build-essential cmake g++ make \
        pkg-config libssl-dev \
        libclang-dev \
    && rm -rf /var/lib/apt/lists/*
COPY . .
RUN cargo build --release --manifest-path V3/Cargo.toml -p zion-pool \
        --features "$FEATURES"

FROM ubuntu:24.04
RUN apt-get update && apt-get install -y \
        ca-certificates libssl3 curl \
        libgcc-s1 libstdc++6 \
    && rm -rf /var/lib/apt/lists/*
RUN groupadd -r zion && useradd -r -g zion -d /data/zion-pool -s /sbin/nologin zion
# NOTE: xmrig installed on host and bind-mounted into container
COPY --from=builder /build/V3/target/release/server /usr/local/bin/zion-pool
RUN mkdir -p /data/zion-pool && chown -R zion:zion /data/zion-pool
EXPOSE 3333 8080
VOLUME ["/data/zion-pool"]
USER zion
ENTRYPOINT ["zion-pool"]


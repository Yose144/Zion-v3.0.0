[Unit]
Description=ZION V3 Mainnet Pool (Stratum, post-hard-reset 3.0.4)
After=network-online.target zion-node.service
Wants=network-online.target
Requires=zion-node.service

[Service]
Type=simple
User=root
EnvironmentFile=/root/zion/edge-environment.sh
ExecStart=/usr/local/bin/zion-pool-server
Restart=always
RestartSec=10
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/data/zion
PrivateTmp=true

[Install]
WantedBy=multi-user.target

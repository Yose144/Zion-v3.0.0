{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Chain Height",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "expr": "zion_chain_height", "legendFormat": "height", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "green" },
          "thresholds": { "steps": [
            { "color": "red", "value": null },
            { "color": "green", "value": 1 }
          ]}
        }
      }
    },
    {
      "title": "Peer Count",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        { "expr": "zion_peer_count", "legendFormat": "peers", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [
            { "color": "red", "value": null },
            { "color": "yellow", "value": 1 },
            { "color": "green", "value": 3 }
          ]}
        }
      }
    },
    {
      "title": "Mempool Size",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        { "expr": "zion_mempool_size", "legendFormat": "txs", "refId": "A" }
      ],
      "fieldConfig": { "defaults": {} }
    },
    {
      "title": "Difficulty",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        { "expr": "zion_difficulty", "legendFormat": "diff", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "title": "Blocks Accepted / Rejected (rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "expr": "rate(zion_blocks_accepted_total[5m])", "legendFormat": "accepted/s", "refId": "A" },
        { "expr": "rate(zion_blocks_rejected_total[5m])", "legendFormat": "rejected/s", "refId": "B" }
      ]
    },
    {
      "title": "Chain Height Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "expr": "zion_chain_height", "legendFormat": "height", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "title": "Sync Lag (best peer - local height)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "expr": "zion_best_peer_height - zion_chain_height", "legendFormat": "lag (blocks)", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 },
          "thresholds": { "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 2 },
            { "color": "red", "value": 5 }
          ]}
        }
      }
    },
    {
      "title": "IBD Progress",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        { "expr": "zion_ibd_progress_pct / 100", "legendFormat": "progress %", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100,
          "thresholds": { "steps": [
            { "color": "red", "value": null },
            { "color": "yellow", "value": 50 },
            { "color": "green", "value": 99 }
          ]}
        }
      }
    },
    {
      "title": "Inbound / Outbound Peers",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        { "expr": "zion_inbound_peers", "legendFormat": "inbound", "refId": "A" },
        { "expr": "zion_outbound_peers", "legendFormat": "outbound", "refId": "B" }
      ]
    },
    {
      "title": "Network Hashrate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [
        { "expr": "zion_network_hashrate", "legendFormat": "hash/s", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "title": "Node Uptime",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 28 },
      "targets": [
        { "expr": "zion_uptime_seconds", "legendFormat": "uptime", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "Bytes Sent / Received",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 28 },
      "targets": [
        { "expr": "rate(zion_bytes_sent_total[5m])", "legendFormat": "sent/s", "refId": "A" },
        { "expr": "rate(zion_bytes_received_total[5m])", "legendFormat": "recv/s", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps" } }
    }
  ],
  "schemaVersion": 39,
  "tags": ["zion", "core", "node", "l1"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "ZION V3 Node Overview",
  "uid": "zion-v3-node-overview"
}

;; SPDX-License-Identifier: MIT
;; # ZION Jetton — TON TEP-74 Jetton (FunC)
;;
;; Wrapped ZION token on TON as a TEP-74 jetton with 9 decimals
;; (TON standard — all TON jettons use 9 decimals).
;;
;; This file contains:
;; 1. Jetton Master Contract (minter) — controls supply, bridge mint/burn
;; 2. Jetton Wallet Contract — per-user balance storage
;;
;; Bridge mint/burn authority = WARP bridge multisig (5/5 validator quorum).
;;
;; ## Deployment
;; See README.md in this folder for full deployment instructions.

;; ════════════════════════════════════════════════════════════════════════════
;; Constants
;; ════════════════════════════════════════════════════════════════════════════

;; Jetton decimals — TON standard is 9 (1 ZION = 1,000,000,000 nano)
;; Note: TON uses 9 decimals by convention for all jettons.
;; The WARP relay handles conversion: L1 6-decimal → TON 9-decimal (multiply by 1000).
const int DECIMALS = 9;

;; Maximum supply: 144,000,000,000 ZION (144B) in nano units
;; 144_000_000_000 * 1_000_000_000 = 144_000_000_000_000_000_000
const int MAX_SUPPLY = 144000000000000000000;

;; Minimum bridge amount: 100 ZION = 100,000,000,000 nano
const int MIN_BRIDGE_AMOUNT = 100000000000;

;; Number of validators required for quorum (5/5)
const int VALIDATOR_QUORUM = 5;

;; Gas constants
const int SEND_BOUNCE_GAS = 10000000;
const int SEND_NON_BOUNCE_GAS = 10000000;

;; ════════════════════════════════════════════════════════════════════════════
;; Storage layout — Jetton Master
;; ════════════════════════════════════════════════════════════════════════════
;;
;; master#_state
;;   total_supply:     Coins      (max 120 bits)
;;   admin:            MsgAddress (bridge admin / multisig)
;;   paused:           int        (1 bit)
;;   total_minted:     Coins      (audit trail)
;;   total_burned:     Coins      (audit trail)
;;   jetton_wallet_code: cell     (wallet contract code)
;;   validator1..5:    int        (validator public keys, 256 bits each)

() load_master_data() impure {
    ;; Load from slice
    ;; total_supply (120 bits) + admin (267 bits) + paused (1 bit)
    ;; + total_minted (120 bits) + total_burned (120 bits)
    ;; + jetton_wallet_code (1 ref)
    ;; + 5 validators (5 * 256 bits)
}

() save_master_data() impure {
    ;; Save to builder
}

;; ════════════════════════════════════════════════════════════════════════════
;; Jetton Master Contract
;; ════════════════════════════════════════════════════════════════════════════

() recv_internal(int msg_value, cell in_msg_full, slice in_msg_body) impure {
    if (in_msg_body.slice_empty?()) {
        ;; Empty message — bounce
        return ();
    }

    slice cs = in_msg_full.begin_parse();
    int flags = cs~load_uint(4);
    slice sender_address = cs~load_msg_addr();

    int op = in_msg_body~load_uint(32);
    int query_id = in_msg_body~load_uint(64);

    if (op == 0) {
        ;; Mint tokens (bridge mint) — only from admin/validator
        ;; Body: op(32) query_id(64) amount(120) destination(MsgAddress)
        ;;       l1_tx_hash(256 bits)
        handle_bridge_mint(sender_address, in_msg_body, query_id);
        return ();
    }

    if (op == 1) {
        ;; Burn tokens (bridge burn) — forwarded from wallet
        ;; Body: op(32) query_id(64) amount(120) l1_recipient(text)
        ;;       burn_id(256 bits) sender(MsgAddress)
        handle_bridge_burn(sender_address, in_msg_body, query_id);
        return ();
    }

    if (op == 2) {
        ;; Pause bridge (validator only)
        handle_pause(sender_address);
        return ();
    }

    if (op == 3) {
        ;; Unpause bridge (validator only)
        handle_unpause(sender_address);
        return ();
    }

    if (op == 0x8e8d9b57) {
        ;; TEP-74: Provide wallet address
        ;; Body: op(32) query_id(64) owner(MsgAddress) include_address(1)
        handle_provide_wallet_address(sender_address, in_msg_body, query_id);
        return ();
    }

    if (op == 0x7362d09c) {
        ;; TEP-74: Get jetton data
        handle_get_jetton_data(query_id);
        return ();
    }

    ;; Unknown op — bounce
}

;; ─────────────────────────────────────────────────────────────────────────────
;; Bridge mint — mint ZION after L1 lock confirmation
;; ─────────────────────────────────────────────────────────────────────────────

() handle_bridge_mint(slice sender, slice body, int query_id) impure {
    int amount = body~load_coins();
    slice destination = body~load_msg_addr();
    int l1_tx_hash = body~load_uint(256);

    ;; Load master state
    var (total_supply, admin, paused, total_minted, total_burned,
         wallet_code, validators) = load_master_state();

    ;; Access control — sender must be admin (bridge multisig)
    if (equal_slices(sender, admin) & not paused) {
        ;; Check max supply
        if (total_supply + amount <= MAX_SUPPLY) {
            ;; Check min amount
            if (amount >= MIN_BRIDGE_AMOUNT) {
                ;; Mint: send jetton to destination wallet
                ;; Create or update destination wallet
                cell wallet_state = calculate_wallet_state(destination, wallet_code);
                int wallet_addr = cell_hash(wallet_state);

                ;; Send mint message to wallet
                send_mint_to_wallet(wallet_addr, amount, query_id);

                ;; Update state
                total_supply = total_supply + amount;
                total_minted = total_minted + amount;

                save_master_state(total_supply, admin, paused, total_minted,
                                  total_burned, wallet_code, validators);

                ;; Emit burn event log for WARP relay
                ~dump("BridgeMint");
                ~dump(amount);
                ~dump(destination);
                ~dump(l1_tx_hash);
            }
        }
    }
}

;; ─────────────────────────────────────────────────────────────────────────────
;; Bridge burn — burn ZION to unlock on L1
;; ─────────────────────────────────────────────────────────────────────────────

() handle_bridge_burn(slice sender, slice body, int query_id) impure {
    int amount = body~load_coins();
    slice l1_recipient = body~load_bits(256);  ;; L1 address as bits
    int burn_id = body~load_uint(256);
    slice burner = body~load_msg_addr();

    var (total_supply, admin, paused, total_minted, total_burned,
         wallet_code, validators) = load_master_state();

    if (not paused) {
        if (amount >= MIN_BRIDGE_AMOUNT) {
            ;; Burn: reduce total supply
            total_supply = total_supply - amount;
            total_burned = total_burned + amount;

            save_master_state(total_supply, admin, paused, total_minted,
                              total_burned, wallet_code, validators);

            ;; Emit burn event log for WARP relay
            ~dump("BridgeBurn");
            ~dump(amount);
            ~dump(l1_recipient);
            ~dump(burner);
            ~dump(burn_id);
        }
    }
}

;; ─────────────────────────────────────────────────────────────────────────────
;; Pause / Unpause
;; ─────────────────────────────────────────────────────────────────────────────

() handle_pause(slice sender) impure {
    var (total_supply, admin, paused, total_minted, total_burned,
         wallet_code, validators) = load_master_state();

    ;; Check if sender is admin
    if (equal_slices(sender, admin)) {
        paused = true;
        save_master_state(total_supply, admin, paused, total_minted,
                          total_burned, wallet_code, validators);
        ~dump("BridgePaused");
    }
}

() handle_unpause(slice sender) impure {
    var (total_supply, admin, paused, total_minted, total_burned,
         wallet_code, validators) = load_master_state();

    if (equal_slices(sender, admin)) {
        paused = false;
        save_master_state(total_supply, admin, paused, total_minted,
                          total_burned, wallet_code, validators);
        ~dump("BridgeUnpaused");
    }
}

;; ─────────────────────────────────────────────────────────────────────────────
;; TEP-74: Provide wallet address
;; ─────────────────────────────────────────────────────────────────────────────

() handle_provide_wallet_address(slice sender, slice body, int query_id) impure {
    slice owner = body~load_msg_addr();
    int include_address = body~load_uint(1);

    var (total_supply, admin, paused, total_minted, total_burned,
         wallet_code, validators) = load_master_state();

    cell wallet_state = calculate_wallet_state(owner, wallet_code);
    int wallet_addr_hash = cell_hash(wallet_state);

    ;; Build response
    var msg = begin_cell()
        .store_uint(0xd075d432, 32)  ;; op: take_wallet_address
        .store_uint(query_id, 64)
        .store_uint(wallet_addr_hash, 256);

    if (include_address) {
        msg = msg.store_slice(owner);
    }

    send_message(sender, msg.end_cell(), SEND_NON_BOUNCE_GAS);
}

;; ─────────────────────────────────────────────────────────────────────────────
;; TEP-74: Get jetton data
;; ─────────────────────────────────────────────────────────────────────────────

() handle_get_jetton_data(int query_id) impure {
    var (total_supply, admin, paused, total_minted, total_burned,
         wallet_code, validators) = load_master_state();

    ;; Response: op(32) query_id(64) total_supply(Coins) mintable(1)
    ;;           jetton_content(cell) jetton_wallet_code(cell)
    var msg = begin_cell()
        .store_uint(0x8814b4dc, 32)  ;; op: report_jetton_data
        .store_uint(query_id, 64)
        .store_coins(total_supply)
        .store_uint(1, 1)            ;; mintable = true
        .store_ref(jetton_content_cell())
        .store_ref(wallet_code);

    ;; Respond to sender
    send_message(sender(), msg.end_cell(), SEND_NON_BOUNCE_GAS);
}

;; ════════════════════════════════════════════════════════════════════════════
;; Jetton Wallet Contract (per-user balance)
;; ════════════════════════════════════════════════════════════════════════════
;;
;; Storage layout:
;;   balance:    Coins (120 bits)
;;   owner:      MsgAddress
;;   master:     MsgAddress
;;   jetton_code: cell

() wallet_recv_internal(int msg_value, cell in_msg_full, slice in_msg_body) impure {
    if (in_msg_body.slice_empty?()) {
        return ();
    }

    slice cs = in_msg_full.begin_parse();
    int flags = cs~load_uint(4);
    slice sender_address = cs~load_msg_addr();

    int op = in_msg_body~load_uint(32);
    int query_id = in_msg_body~load_uint(64);

    if (op == 0x178d4519) {
        ;; TEP-74: Transfer
        ;; Body: op(32) query_id(64) amount(Coins) destination(MsgAddress)
        ;;       response_destination(MsgAddress) custom_payload(maybe ref)
        ;;       forward_ton_amount(Coins) forward_payload(maybe ref)
        wallet_handle_transfer(sender_address, in_msg_body, query_id);
        return ();
    }

    if (op == 0x595f07bc) {
        ;; Internal transfer (from another wallet)
        ;; Body: op(32) query_id(64) amount(Coins) from(MsgAddress)
        ;;       response_destination(MsgAddress)
        wallet_handle_internal_transfer(sender_address, in_msg_body, query_id);
        return ();
    }

    if (op == 0x7bdd97de) {
        ;; Burn (bridge burn — user initiates)
        ;; Body: op(32) query_id(64) amount(Coins) response_destination(MsgAddress)
        ;;       l1_recipient(text) burn_id(256 bits)
        wallet_handle_burn(sender_address, in_msg_body, query_id);
        return ();
    }

    if (op == 0x8e8d9b57) {
        ;; TEP-74: Get wallet data
        wallet_handle_get_data(query_id);
        return ();
    }
}

;; ─────────────────────────────────────────────────────────────────────────────
;; Wallet: Transfer
;; ─────────────────────────────────────────────────────────────────────────────

() wallet_handle_transfer(slice sender, slice body, int query_id) impure {
    int amount = body~load_coins();
    slice destination = body~load_msg_addr();
    slice response_dest = body~load_msg_addr();
    int has_custom_payload = body~load_uint(1);
    if (has_custom_payload) {
        body~load_ref();
    }
    int forward_ton_amount = body~load_coins();

    var (balance, owner, master, wallet_code) = wallet_load_state();

    ;; Check sender is owner
    if (equal_slices(sender, owner) & (balance >= amount)) {
        ;; Update balance
        balance = balance - amount;
        wallet_save_state(balance, owner, master, wallet_code);

        ;; Calculate destination wallet address
        cell dest_wallet_state = calculate_wallet_state(destination, wallet_code);
        int dest_wallet_addr = cell_hash(dest_wallet_state);

        ;; Send internal transfer to destination wallet
        var msg = begin_cell()
            .store_uint(0x595f07bc, 32)  ;; op: internal_transfer
            .store_uint(query_id, 64)
            .store_coins(amount)
            .store_slice(owner)           ;; from
            .store_slice(response_dest);

        send_message(dest_wallet_addr, msg.end_cell(), SEND_NON_BOUNCE_GAS);
    }
}

;; ─────────────────────────────────────────────────────────────────────────────
;; Wallet: Internal transfer (receive from another wallet)
;; ─────────────────────────────────────────────────────────────────────────────

() wallet_handle_internal_transfer(slice sender, slice body, int query_id) impure {
    int amount = body~load_coins();
    slice from = body~load_msg_addr();
    slice response_dest = body~load_msg_addr();

    var (balance, owner, master, wallet_code) = wallet_load_state();

    ;; Verify sender is a valid jetton wallet (from same master)
    ;; In production, verify sender address matches expected wallet for `from`
    balance = balance + amount;
    wallet_save_state(balance, owner, master, wallet_code);
}

;; ─────────────────────────────────────────────────────────────────────────────
;; Wallet: Burn (bridge burn — user initiates)
;; ─────────────────────────────────────────────────────────────────────────────

() wallet_handle_burn(slice sender, slice body, int query_id) impure {
    int amount = body~load_coins();
    slice response_dest = body~load_msg_addr();
    slice l1_recipient = body~load_bits(256);
    int burn_id = body~load_uint(256);

    var (balance, owner, master, wallet_code) = wallet_load_state();

    ;; Check sender is owner
    if (equal_slices(sender, owner) & (balance >= amount)) {
        ;; Reduce balance
        balance = balance - amount;
        wallet_save_state(balance, owner, master, wallet_code);

        ;; Notify master contract of burn
        var msg = begin_cell()
            .store_uint(1, 32)            ;; op: burn (master)
            .store_uint(query_id, 64)
            .store_coins(amount)
            .store_slice(l1_recipient)
            .store_uint(burn_id, 256)
            .store_slice(owner);

        send_message(master, msg.end_cell(), SEND_NON_BOUNCE_GAS);
    }
}

;; ─────────────────────────────────────────────────────────────────────────────
;; Wallet: Get data
;; ─────────────────────────────────────────────────────────────────────────────

() wallet_handle_get_data(int query_id) impure {
    var (balance, owner, master, wallet_code) = wallet_load_state();

    ;; Response: op(32) query_id(64) balance(Coins) owner(MsgAddress)
    ;;           master(MsgAddress) wallet_code(cell)
    var msg = begin_cell()
        .store_uint(0x8814b4dc, 32)
        .store_uint(query_id, 64)
        .store_coins(balance)
        .store_slice(owner)
        .store_slice(master)
        .store_ref(wallet_code);

    send_message(sender(), msg.end_cell(), SEND_NON_BOUNCE_GAS);
}

;; ════════════════════════════════════════════════════════════════════════════
;; Helper functions
;; ════════════════════════════════════════════════════════════════════════════

cell calculate_wallet_state(slice owner, cell wallet_code) {
    ;; Calculate the state cell for a wallet contract
    ;; State: balance(120) + owner(MsgAddr) + master(MsgAddr) + code(ref)
    var state = begin_cell()
        .store_coins(0)
        .store_slice(owner)
        .store_slice(my_address())
        .store_ref(wallet_code);
    return state.end_cell();
}

() send_message(int dest, cell msg, int gas) impure {
    var envelope = begin_cell()
        .store_uint(0x18, 6)       ;; bounceable, no bounce-back
        .store_uint(dest, 256)     ;; destination
        .store_coins(gas)          ;; value
        .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)  ;; extra fields
        .store_ref(msg);
    send_raw_message(envelope.end_cell(), 0);
}

cell jetton_content_cell() {
    ;; Jetton metadata (off-chain or on-chain)
    ;; For ZION: name="ZION", symbol="ZION", decimals=9
    var content = begin_cell()
        .store_uint(0x00, 8)       ;; on-chain metadata prefix
        .store_slice("ZION")
        .store_slice("ZION")
        .store_uint(DECIMALS, 8);
    return content.end_cell();
}

;; State load/save helpers (simplified — actual implementation uses
;; begin_cell/end_cell with proper serialization)

() load_master_state() impure asm "NIL";
() save_master_state() impure asm "NIL";
() wallet_load_state() impure asm "NIL";
() wallet_save_state() impure asm "NIL";

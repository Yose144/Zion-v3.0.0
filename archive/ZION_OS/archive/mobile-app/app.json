{
  "expo": {
    "name": "ZION Mobile",
    "slug": "zion-mobile",
    "version": "3.0.0",
    "orientation": "portrait",
    "platforms": ["ios", "android", "web"],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0c1c"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zionterranova.mobile",
      "buildNumber": "7",
      "infoPlist": {
        "NSCameraUsageDescription": "ZION uses the camera to scan QR codes for wallet addresses and payments.",
        "NSFaceIDUsageDescription": "ZION uses Face ID to securely unlock your wallet.",
        "NSBiometryUsageDescription": "ZION uses biometric authentication to protect your private keys.",
        "UIBackgroundModes": ["fetch", "remote-notification"]
      }
    },
    "android": {
      "package": "com.zionterranova.mobile",
      "versionCode": 7,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0c1c"
      },
      "permissions": [
        "CAMERA",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "zion-mobile"
      }
    }
  }
}

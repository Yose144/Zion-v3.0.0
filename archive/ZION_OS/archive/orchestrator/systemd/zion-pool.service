[Unit]
Description=ZION Pool Server - Stratum mining, share validation, PPLNS
Documentation=https://github.com/Yose144/Zion-v3.0.0/blob/main/ZION_OS/README.md
After=zion-node.service
Wants=zion-node.service

[Service]
Type=simple
User=zion
Group=zion
WorkingDirectory=/opt/zion

Environment=ZION_POOL_BIND=0.0.0.0:8444
Environment=ZION_NODE_RPC_ADDR=127.0.0.1:8443
Environment=ZION_POOL_LOOP_COUNT=1000000
Environment=ZION_NONCE_COUNT=4096

ExecStartPre=/bin/sleep 5
ExecStart=/opt/zion/V3/target/release/zion-pool-server
ExecStop=/bin/kill -TERM $MAINPID

Restart=on-failure
RestartSec=5
StartLimitInterval=60
StartLimitBurst=3

LimitNOFILE=65536
LimitNPROC=4096

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/zion/logs

StandardOutput=append:/opt/zion/logs/pool.log
StandardError=append:/opt/zion/logs/pool.log
SyslogIdentifier=zion-pool

[Install]
WantedBy=multi-user.target

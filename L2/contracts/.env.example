# ──────────────────────────────────────────────────────────────
#  ZION Bridge Contracts — Environment Variables
# ──────────────────────────────────────────────────────────────
#
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to git!
#
#  Deployment account needs:
#   - Base Sepolia ETH (faucet: https://faucet.quicknode.com/base/sepolia)
#   - ~0.02 ETH for gas (2 contracts + 2 role TXs + buffer)
#
#  Generate wallets: npx hardhat run scripts/gen-wallets.ts

# ── Deployer private key (Validator 1 — primary relay) ────────
DEPLOYER_PRIVATE_KEY=0x_YOUR_PRIVATE_KEY_HERE

# ── Second validator address (Validator 2 — secondary relay) ──
# Generated by scripts/gen-wallets.ts  — address only (no private key needed here)
VALIDATOR2_ADDRESS=0x_VALIDATOR2_ADDRESS_HERE

# ── RPC overrides (optional — public RPCs work for testnet) ───
# BASE_SEPOLIA_RPC=https://base-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# ARB_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc

# ── Etherscan/Basescan API keys (for contract verification) ───
# BASESCAN_API_KEY=YOUR_BASESCAN_API_KEY
# ARBISCAN_API_KEY=YOUR_ARBISCAN_API_KEY
# BSCSCAN_API_KEY=YOUR_BSCSCAN_API_KEY

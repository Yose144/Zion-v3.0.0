# /etc/zion/pool-standby.env — EDGE2 warm-standby env (A4.2)
# Root-only file (chmod 600). Copy the pool-relevant values from EDGE
# /etc/zion/edge-environment.sh; NEVER commit a filled copy to git.
#
# PARITY RULE (learned 2026-10-31 the hard way): this file is a MIRROR of the
# primary env. Three values had silently diverged and would each have broken a
# promote: payout wallet (old, ~6.8k ZION wallet), payout signing key (matching
# the OLD wallet) and the PPLNS window (1000x smaller → different split than
# miners saw before the outage). Verify with:
#   bash scripts/ops/dr-parity-check.sh            # 0 fail required
#   bash scripts/ops/dr-parity-check.sh --only secrets
# Parity-critical values are ALSO pinned as explicit flags in
# units/zion-pool-standby.service (flags win over this file).

# --- required by pool-standby-sync.sh -----------------------------------
# Same key the EDGE pool API expects for /api/* (ZION_POOL_API_KEY on EDGE).
ZION_POOL_API_KEY=
# Export endpoint via zion-edge-tunnel loopback forward (leave as-is).
ZION_POOL_API_URL=http://127.0.0.1:8080
# Standby state dir (leave as-is).
ZION_POOL_STANDBY_DIR=/opt/zion/data/v31-standby

# --- required by pool-ha-watchdog.sh ------------------------------------
# Public EDGE probes.
ZION_POOL_EDGE_HOST=62.171.141.136
ZION_POOL_EDGE_STRATUM_PORT=8444
# Telegram alerting (same bot the pool uses).
ZION_TELEGRAM_BOT_TOKEN=
ZION_TELEGRAM_CHAT_ID=
# Optional tuning: ZION_POOL_HA_FAIL_LIMIT=3, ZION_POOL_HA_ALERT_COOLDOWN_S=1800

# --- pool identity / payout (MUST equal EDGE) ---------------------------
# Canonical pool payout wallet. Substituted into ExecStart as
# `--miner-address ${ZION_POOL_WALLET}`; a wrong value sends the block coinbase
# to an address the pool cannot spend. EDGE value (2026-10-31):
#   zion1d2k5v0p6p2z667l7g522v2z0w0y6e7w742zq8k6
ZION_POOL_WALLET=
# Belt-and-braces copy of the same address, read directly by the binary
# (clap env ZION_POOL_MINER_ADDRESS). Leave equal to ZION_POOL_WALLET.
# Without it the binary falls back to the literal default `zion1pool`.
ZION_POOL_MINER_ADDRESS=
# Hex (64 chars) Ed25519 signing key for ZION_POOL_WALLET — MUST be
# byte-identical to EDGE `ZION_POOL_WALLET_KEY`. Never copy it through shell
# history/echo; pipe or scp it host-to-host and re-run
# `dr-parity-check.sh --only secrets` afterwards (it prints sha256 only).
ZION_POOL_WALLET_KEY=

# --- PPLNS economics (MUST equal EDGE) ---------------------------------
# EDGE runs --pplns-window-size 500000000. A smaller window here means the
# standby would recompute the split over a different history right after a
# promote. Also pinned as a flag in the unit file.
ZION_PPLNS_WINDOW_SIZE=500000000
# Pearl shares are paid natively, never through the ZION PPLNS window.
ZION_POOL_NATIVE_PAYOUT_COINS=prl

# --- pinned by the unit file, do NOT set here --------------------------
# The unit passes these as flags so they cannot drift with the env:
#   --bind 0.0.0.0:8444            (stratum; opens after promote)
#   --l1-rpc-url http://127.0.0.1:9445  (EDGE2 local L1 node, not the tunnel)
#   --state-path /opt/zion/data/v31-standby/pool-pplns.json
#   --store-db-path /opt/zion/data/v31-standby/pool-store.db
#   --api-bind 127.0.0.1:8090      (8080 is the EDGE tunnel on EDGE2)
#   --pool-fee-bps 100
# Setting ZION_PPLNS_STATE_PATH / ZION_POOL_STORE_DB_PATH / ZION_POOL_API_BIND
# here has no effect (flags win) and only re-creates the drift this file exists
# to prevent.

# --- mirror the rest of EDGE env verbatim below ------------------------
# ZION_POOL_STRATUM_PORT=8444 … (auxpow routes, telegram, ZIS, pearl, …)

[Unit]
Description=ZION V31 NCL — L3 Neural Compute Layer marketplace (localhost API)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zion
Group=zion
WorkingDirectory=/opt/zion
EnvironmentFile=/etc/zion/edge-environment.sh
Environment="RUST_LOG=info,zion_ncl=info"
Environment="NCL_BIND=127.0.0.1:8098"
Environment="NCL_DB_PATH=/opt/zion/data/ncl/ncl.db"
Environment="NCL_MAX_QUEUE=1000"
ExecStart=/opt/zion/V31/target/release/zion-ncl
Restart=always
RestartSec=10
KillMode=process
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal

# Security hardening (unprivileged zion user)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=yes
ReadWritePaths=/opt/zion/data/ncl /opt/zion/logs /var/log/zion
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target

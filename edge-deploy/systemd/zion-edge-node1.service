[Unit]
Description=ZION Edge Node 1 (Primary / Genesis)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zion
Group=zion
WorkingDirectory=/opt/zion
EnvironmentFile=/etc/zion/edge-environment.sh
Environment="ZION_NODE_ID=zion-edge-primary"
Environment="ZION_P2P_BIND=0.0.0.0:8333"
Environment="ZION_RPC_BIND=127.0.0.1:8443"
Environment="ZION_WEBSOCKET_BIND=127.0.0.1:8445"
Environment="ZION_METRICS_BIND=127.0.0.1:9100"
Environment="ZION_SEED_PEERS=none"
Environment="ZION_NODE_STATE_PATH=/opt/zion/data/edge-state.db"
Environment="ZION_MIGRATION_HEIGHT=1"
Environment="RUST_LOG=info,zion_core=debug"
ExecStart=/opt/zion/V3/target/release/node
Restart=always
RestartSec=10
KillMode=process
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

# Security hardening (unprivileged zion user)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=yes
ReadWritePaths=/opt/zion/data /opt/zion/logs
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target

[Unit]
Description=ZION Edge Node 1 (Primary / Genesis)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zion
Group=zion
WorkingDirectory=/opt/zion
EnvironmentFile=/etc/zion/edge-environment.sh
Environment="ZION_SEED_PEERS=none"
Environment="RUST_LOG=info,zion_core=debug"
ExecStart=/opt/zion/V3/target/release/node
Restart=always
RestartSec=10
KillMode=process
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

# Security hardening (unprivileged zion user)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=yes
ReadWritePaths=/opt/zion/data /opt/zion/logs
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target

[Unit]
Description=ZION Edge WARP (L3 Cross-Chain Relay)
After=network-online.target zion-edge-node1.service
Wants=network-online.target
Requires=zion-edge-node1.service

[Service]
Type=simple
User=zion
Group=zion
WorkingDirectory=/opt/zion
EnvironmentFile=/opt/zion/edge-deploy/config/edge-environment.sh
Environment="WARP_API_BIND=0.0.0.0:8453"
Environment="WARP_METRICS_BIND=0.0.0.0:9104"
Environment="RUST_LOG=info,zion_warp=debug"
ExecStart=/opt/zion/V3/target/release/zion-warp-server
Environment="WARP_CONFIG=/opt/zion/V3/L3/warp/config/warp-mainnet.toml"
Restart=always
RestartSec=10
KillMode=process
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

# Security hardening (unprivileged zion user)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=yes
ReadWritePaths=/opt/zion/data /opt/zion/logs
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target

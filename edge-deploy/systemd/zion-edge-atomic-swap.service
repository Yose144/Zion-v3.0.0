[Unit]
Description=ZION Edge Atomic Swap (L2 HTLC)
After=network-online.target zion-edge-node1.service
Wants=network-online.target
Requires=zion-edge-node1.service

[Service]
Type=simple
User=zion
Group=zion
WorkingDirectory=/opt/zion
EnvironmentFile=/etc/zion/edge-environment.sh
Environment="RUST_LOG=info,zion_atomic_swap=debug"
ExecStart=/opt/zion/V3/target/release/zion-atomic-swap --config /opt/zion/V3/L2/atomic-swap/config/swap-mainnet.toml
Restart=always
RestartSec=10
KillMode=process
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

# Security hardening (unprivileged zion user)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=yes
ReadWritePaths=/data/zion /opt/zion/data /opt/zion/logs /var/log/zion
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target

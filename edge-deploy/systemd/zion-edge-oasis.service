[Unit]
Description=ZION OASIS Avatar Hub (L4)
After=network-online.target zion-edge-node1.service
Wants=network-online.target
Requires=zion-edge-node1.service

[Service]
Type=simple
User=zion
Group=zion
WorkingDirectory=/opt/zion
EnvironmentFile=/etc/zion/edge-environment.sh
Environment="OASIS_BIND=127.0.0.1"
Environment="OASIS_PORT=8094"
Environment="OASIS_METRICS_HOST=127.0.0.1"
Environment="OASIS_METRICS_PORT=9102"
Environment="OASIS_DB=/data/zion/oasis.db"
Environment="RUST_LOG=info"
ExecStart=/opt/zion/V3/target/release/zion-oasis
Restart=always
RestartSec=10
KillMode=process
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

# Security hardening (unprivileged zion user)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=yes
ReadWritePaths=/opt/zion/data /opt/zion/logs /data/zion
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target

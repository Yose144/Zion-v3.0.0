[Unit]
Description=ZION Edge LND (Lightning Network Daemon) — WARP Lightning Backend
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=zion
Group=zion
SupplementaryGroups=docker
WorkingDirectory=/opt/zion/V3/L3/warp/docker/lightning
ExecStart=/usr/bin/docker compose up lnd
ExecStop=/usr/bin/docker compose stop lnd
Restart=always
RestartSec=15
KillMode=process
TimeoutStopSec=60
StandardOutput=journal
StandardError=journal

# Security hardening (runs as zion; docker access via SupplementaryGroups=docker)
NoNewPrivileges=true
PrivateTmp=yes
ProtectHome=true
# ProtectSystem is intentionally relaxed because docker compose needs host paths

[Install]
WantedBy=multi-user.target

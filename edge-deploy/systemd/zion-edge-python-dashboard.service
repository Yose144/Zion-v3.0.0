[Unit]
Description=ZION V3 Dashboard (Python, zero-dep, port 8766)
After=network-online.target zion-edge-node1.service zion-edge-pool.service
Wants=network-online.target

[Service]
Type=simple
User=zion
Group=zion
WorkingDirectory=/opt/zion/ZION_OS/dashboard
ExecStart=/usr/bin/python3 /opt/zion/ZION_OS/dashboard/app.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Environment: DASHBOARD_USERS must be set in /etc/zion/edge-environment.sh
EnvironmentFile=/etc/zion/edge-environment.sh

# Security hardening (unprivileged zion user)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=yes
ReadWritePaths=/opt/zion/data /opt/zion/logs /opt/zion/ZION_OS/dashboard/logs
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target

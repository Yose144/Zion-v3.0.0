[Unit]
Description=ZION Edge Pool (Primary)
After=network-online.target zion-edge-node1.service
Wants=network-online.target
Requires=zion-edge-node1.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/zion-2.9.6-main
EnvironmentFile=/root/zion-2.9.6-main/edge-deploy/config/edge-environment.sh
Environment="RUST_LOG=info,zion_pool=debug"
Environment="ZION_POOL_BIND=0.0.0.0:8444"
Environment="ZION_NODE_RPC_ADDR=127.0.0.1:8443"
Environment="ZION_POOL_LOOP_COUNT=1000000"
Environment="ZION_POOL_ALGORITHM=deeksha_lite_v1"
ExecStart=/root/zion-2.9.6-main/V3/target/release/server
Restart=always
RestartSec=10
KillMode=process
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

# Security hardening (relax as needed)
NoNewPrivileges=false
ProtectSystem=false
ProtectHome=false

[Install]
WantedBy=multi-user.target

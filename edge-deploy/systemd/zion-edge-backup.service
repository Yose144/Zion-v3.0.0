[Unit]
Description=ZION Edge Server Database & Config Backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=zion
Group=zion
ExecStart=/opt/zion/ZION_OS/infra/scripts/backup-edge.sh
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=true
PrivateTmp=yes

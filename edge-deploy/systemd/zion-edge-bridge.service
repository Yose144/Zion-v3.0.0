[Unit]
Description=ZION Edge Bridge (L2 Cross-Chain Relay)
After=network-online.target zion-edge-node1.service
Wants=network-online.target
Requires=zion-edge-node1.service

[Service]
Type=simple
User=zion
Group=zion
WorkingDirectory=/opt/zion
EnvironmentFile=/etc/zion/edge-environment.sh
Environment="RUST_LOG=info,zion_bridge=debug"
Environment="ZION_BRIDGE_CONFIG=/opt/zion/V3/L2/bridge/config/bridge-mainnet.toml"
ExecStart=/opt/zion/V3/target/release/zion-bridge --config /opt/zion/V3/L2/bridge/config/bridge-mainnet.toml
Restart=always
RestartSec=10
KillMode=process
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

# Security hardening (unprivileged zion user)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=yes
ReadWritePaths=/data/zion /opt/zion/data /opt/zion/logs /var/log/zion
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target

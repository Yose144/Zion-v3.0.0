[Unit]
Description=ZION Edge Node 2 (Follower / P2P Peer)
After=network-online.target zion-edge-node1.service
Wants=network-online.target
Requires=zion-edge-node1.service

[Service]
Type=simple
User=zion
Group=zion
WorkingDirectory=/opt/zion
EnvironmentFile=/etc/zion/edge-environment.sh
Environment="ZION_NODE_ID=zion-edge-follower"
Environment="ZION_P2P_BIND=0.0.0.0:8334"
Environment="ZION_RPC_BIND=127.0.0.1:8446"
Environment="ZION_METRICS_BIND=127.0.0.1:9116"
Environment="ZION_WEBSOCKET_BIND=127.0.0.1:8447"
Environment="ZION_SEED_PEERS=127.0.0.1:8333"
Environment="ZION_NODE_STATE_PATH=/opt/zion/data/edge2-state.db"
Environment="ZION_MIGRATION_HEIGHT=1"
Environment="RUST_LOG=info,zion_core=debug"
ExecStart=/opt/zion/V3/target/release/node
Restart=always
RestartSec=10
KillMode=process
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

# Security hardening (unprivileged zion user)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=yes
ReadWritePaths=/opt/zion/data /opt/zion/logs
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target

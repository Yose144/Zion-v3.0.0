[Unit]
Description=ZION V31 Edge Node 2 (P2P Peer of primary)
After=network-online.target zion-v31-node.service
Wants=network-online.target
Requires=zion-v31-node.service

[Service]
Type=simple
User=zion
Group=zion
WorkingDirectory=/opt/zion
EnvironmentFile=/etc/zion/edge-environment.sh
Environment="RUST_LOG=info,zion_core=debug"
Environment="ZION_SEED_PEERS=127.0.0.1:8335"
ExecStart=/opt/zion/V31/target/release/zion-node --db-path /opt/zion/data/v31/node2.db --rpc 127.0.0.1:9447 --p2p 0.0.0.0:8337 --node-id zion-edge-node2 --peer 127.0.0.1:8335
Restart=always
RestartSec=10
KillMode=process
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

# Security hardening (unprivileged zion user)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=yes
ReadWritePaths=/data/zion /opt/zion/data /opt/zion/logs /var/log/zion
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target

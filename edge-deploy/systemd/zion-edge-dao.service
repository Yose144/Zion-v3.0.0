[Unit]
Description=ZION Edge DAO (L2 Governance)
After=network-online.target zion-edge-node1.service
Wants=network-online.target
Requires=zion-edge-node1.service

[Service]
Type=simple
User=zion
Group=zion
WorkingDirectory=/opt/zion
EnvironmentFile=/opt/zion/edge-deploy/config/edge-environment.sh
Environment="DAO_API_PORT=8450"
Environment="DAO_CONFIG=/opt/zion/V3/L2/dao/config/dao-mainnet.toml"
Environment="DAO_DB_PATH=/opt/zion/data/edge-dao.db"
Environment="DAO_L1_RPC=http://127.0.0.1:8443/jsonrpc"
Environment="RUST_LOG=info,zion_dao=debug"
ExecStart=/opt/zion/V3/target/release/zion-dao
Restart=always
RestartSec=10
KillMode=process
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

# Security hardening (unprivileged zion user)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=yes
ReadWritePaths=/opt/zion/data /opt/zion/logs
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target

[Unit]
Description=ZION Edge DAO (L2 Governance)
After=network-online.target tailscaled.service zion-edge-node1.service
Wants=network-online.target
Requires=zion-edge-node1.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/zion-2.9.6-main
EnvironmentFile=/root/zion-2.9.6-main/edge-deploy/config/edge-environment.sh
Environment="DAO_API_PORT=8450"
Environment="DAO_CONFIG=/root/zion-2.9.6-main/V3/L2/dao/config/dao-mainnet.toml"
Environment="DAO_DB_PATH=/root/zion-2.9.6-main/data/edge-dao.db"
Environment="DAO_L1_RPC=http://127.0.0.1:8443/jsonrpc"
Environment="RUST_LOG=info,zion_dao=debug"
ExecStart=/root/zion-2.9.6-main/V3/target/release/zion-dao
Restart=always
RestartSec=10
KillMode=process
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

# Security hardening (relax as needed)
NoNewPrivileges=false
ProtectSystem=false
ProtectHome=false

[Install]
WantedBy=multi-user.target

[Unit]
Description=ZionOS Dashboard (Unified Infrastructure View)
After=network-online.target zion-edge-node1.service zion-edge-pool.service zion-edge-dao.service zion-edge-warp.service zion-edge-agent.service
Wants=network-online.target

[Service]
Type=simple
User=zion
Group=zion
WorkingDirectory=/opt/zion/ZION_OS/dashboard/infra
EnvironmentFile=/etc/zion/edge-environment.sh
Environment="RUST_LOG=info"
Environment="ZIONOS_BIND=127.0.0.1:8888"
Environment="ZIONOS_DATA_DIR=/opt/zion/data/dashboard"
Environment="ZIONOS_NODE_RPC=http://127.0.0.1:9443"
Environment="ZIONOS_POOL_METRICS=http://127.0.0.1:8455"
Environment="ZIONOS_DAO_API=http://127.0.0.1:8450"
Environment="ZIONOS_WARP_API=http://127.0.0.1:8453"
Environment="ZIONOS_AGENT_API=http://127.0.0.1:8767"
ExecStart=/usr/local/bin/zionos-dashboard
Restart=always
RestartSec=10

# Security hardening (unprivileged zion user)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=yes
ReadWritePaths=/opt/zion/data /opt/zion/logs
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target

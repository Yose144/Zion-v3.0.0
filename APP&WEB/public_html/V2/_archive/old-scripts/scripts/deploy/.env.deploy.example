# Deployment configuration for Webglobe (SFTP/SCP)

# SFTP server
SFTP_HOST=ftp.newearth.cz
SFTP_PORT=222
SFTP_USER=YOUR_FTP_USERNAME

# Remote paths
# Shared hosting typically exposes public_html as the web root
REMOTE_V2_PATH=public_html/V2

# Optional: deploy API as well (set to api/presale remote path if applicable)
# Leave empty to skip API deploy on shared hosting
REMOTE_API_PATH=

# Options
# If true, the script will create a timestamped backup of the remote V2 folder before deploying
BACKUP_BEFORE_DEPLOY=true
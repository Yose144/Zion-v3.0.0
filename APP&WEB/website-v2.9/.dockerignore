# Dependencies / build artifacts
# NOTE: node_modules and .next are intentionally kept in the build context
# because the production Docker image is built from host artifacts on the
# Edge server (npm install inside Docker fails for the local .tgz dependency).
!node_modules
!.next

# VCS
.git

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Exclude hidden temp files in downloads (docker build context can break on these)
public/downloads/**/.*

# Development environment (local testing against V3 Mainnet server)
# API calls go through nginx proxy on V3 Mainnet server

# For local development pointing to V3 Mainnet
NEXT_PUBLIC_API_URL=https://zionterranova.com/api
NEXT_PUBLIC_BLOCKCHAIN_RPC_URL=https://zionterranova.com/blockchain-rpc
NEXT_PUBLIC_POOL_API_URL=https://zionterranova.com/pool

# OR for testing against localhost (when running backend locally):
# NEXT_PUBLIC_API_URL=http://localhost:8001
# NEXT_PUBLIC_BLOCKCHAIN_RPC_URL=http://localhost:8443
# NEXT_PUBLIC_POOL_API_URL=http://localhost:8080
# NEXT_PUBLIC_DAO_API_URL=http://localhost:8081

# Optional: override /api/network and /api/network/best-pool sources
# ZION_NETWORK_NODES_JSON='[{"id":"prague-eu","name":"Prague Primary","host":"91.98.122.165","region":"EU","lat":50.08,"lon":14.44,"ports":{"p2p":8333,"rpc":8443,"stratum":3333,"pool_api":8080}},{"id":"usa-west","name":"USA Hillsboro","host":"5.78.194.94","region":"US","lat":45.52,"lon":-122.99,"ports":{"p2p":8333,"rpc":8443,"stratum":3333,"pool_api":8080}},{"id":"singapore-ap","name":"Singapore","host":"5.223.84.191","region":"APAC","lat":1.35,"lon":103.82,"ports":{"p2p":8333,"rpc":8443,"stratum":3333,"pool_api":8080}}]'
# ZION_MINING_POOLS_JSON='[{"id":"pool-primary","name":"Primary Pool","host":"91.98.122.165","port":3333,"region":"PRIMARY","lat":0,"lon":0}]'

# Bridge relay Prometheus metrics endpoint (port 9100)
BRIDGE_METRICS_URL=http://localhost:9100/metrics

# Development environment (local testing against the public ZION stack)
# API calls go through nginx proxy on the public endpoint.

# For local development pointing to the public ZION endpoint:
NEXT_PUBLIC_API_URL=https://zionterranova.com/api
NEXT_PUBLIC_BLOCKCHAIN_RPC_URL=https://zionterranova.com/blockchain-rpc
NEXT_PUBLIC_POOL_API_URL=https://zionterranova.com/pool
NEXT_PUBLIC_ZION_RPC_HOST=rpc.zionterranova.com
NEXT_PUBLIC_ZION_POOL_HOST=pool.zionterranova.com

# ZionDex Router API (cross-chain DEX)
NEXT_PUBLIC_ZIONDEX_ROUTER_URL=http://localhost:8454

# OR for testing against a local backend:
# NEXT_PUBLIC_API_URL=http://localhost:8001
# NEXT_PUBLIC_BLOCKCHAIN_RPC_URL=http://localhost:8443
# NEXT_PUBLIC_POOL_API_URL=http://localhost:8455
# NEXT_PUBLIC_ZION_RPC_HOST=localhost
# NEXT_PUBLIC_ZION_POOL_HOST=localhost

# Server-side overrides (used by API routes in /src/app/api)
ZION_EDGE_HOST=127.0.0.1
ZION_DAO_API_URL=http://127.0.0.1:8450
ZION_POOL_API_URL=http://127.0.0.1:8455
ZION_DAO_API_KEY=dev-dao-key
ZION_WARP_API_KEY=dev-warp-key
ZION_JWT_SECRET=dev-secret-min-32-characters-long
ADMIN_USER=admin
ADMIN_PASSWORD=dev-admin-password

# Optional: override network and pool metadata served by /api/network
# ZION_NETWORK_NODES_JSON='[]'
# ZION_MINING_POOLS_JSON='[]'

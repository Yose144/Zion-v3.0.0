# Development environment (local testing against TestNet server)
# API calls go through nginx proxy on TestNet server

# For local development pointing to TestNet
NEXT_PUBLIC_API_URL=https://zionterranova.com/api
NEXT_PUBLIC_BLOCKCHAIN_RPC_URL=https://zionterranova.com/blockchain-rpc
NEXT_PUBLIC_POOL_API_URL=https://zionterranova.com/pool

# OR for testing against localhost (when running backend locally):
# NEXT_PUBLIC_API_URL=http://localhost:8001
# NEXT_PUBLIC_BLOCKCHAIN_RPC_URL=http://localhost:8444
# NEXT_PUBLIC_POOL_API_URL=http://localhost:8080
# NEXT_PUBLIC_DAO_API_URL=http://localhost:8081

# Optional: override /api/network and /api/network/best-pool sources
# ZION_NETWORK_NODES_JSON='[{"id":"seed-helsinki","name":"Helsinki","host":"77.42.31.72","region":"EU-NORTH","lat":60.17,"lon":24.94,"ports":{"p2p":8334,"rpc":8444,"stratum":3333,"pool_api":8080,"dao_api":8081}}]'
# ZION_MINING_POOLS_JSON='[{"id":"pool-eu","name":"EU Pool","host":"pool.zionterranova.com","port":3333,"region":"EU-NORTH","lat":60.17,"lon":24.94}]'

# Bridge relay Prometheus metrics endpoint (port 9100)
BRIDGE_METRICS_URL=http://localhost:9100/metrics

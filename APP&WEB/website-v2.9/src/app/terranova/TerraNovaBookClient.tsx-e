export interface AccelerationDirection {
  id: string;
  titleCs: string;
  titleEn: string;
  descCs: string;
  descEn: string;
  color: string;
  rgb: string;
  symbol: string;
}

export const ACCELERATION_DIRECTIONS: AccelerationDirection[] = [
  {
    id: 'l1',
    titleCs: 'L1 Genesis (2026)',
    titleEn: 'L1 Genesis (2026)',

                  <div className="h-5 w-1.5 bg-sky-400/70 shadow-[0_0_8px_rgba(56,189,248,0.6)] rounded-[1px]"></div>
                  <div className="h-5 w-1.5 bg-sky-500/40 rounded-[1px]"></div>
                  <div className="h-5 w-1.5 bg-sky-600/20 rounded-[1px]"></div>

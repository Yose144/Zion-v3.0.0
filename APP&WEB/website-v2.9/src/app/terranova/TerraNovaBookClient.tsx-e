            <p className="text-gray-300 leading-relaxed">
              {cs ? meta.aboutCs : meta.aboutEn}
            </p>
            <p className="text-gray-400 leading-relaxed text-sm">
              {cs ? meta.layersCs : meta.layersEn}
            </p>


# === ZION Website v2.9 — Production Environment ===
# Copy this file to .env.production on the Edge server and fill in real values.
# NEVER commit .env.production to git — it is ignored by .gitignore.

# Public (included in the client JS bundle — use only DNS names, never IPs)
NEXT_PUBLIC_ZION_RPC_HOST=rpc.zionterranova.com
NEXT_PUBLIC_ZION_POOL_HOST=stratum.zionterranova.com
NEXT_PUBLIC_WS_URL=wss://app.zionterranova.com/ws
# ZionDex Router API (cross-chain DEX)
NEXT_PUBLIC_ZIONDEX_ROUTER_URL=https://dex.zionterranova.com
# Optional: comma-separated list of additional RPC nodes (e.g. for fallback)
# NEXT_PUBLIC_ZION_RPC_EXTRA_NODES=https://app.zionterranova.com/rpc

# Server-only (never exposed to browser)
ZION_EDGE_HOST=127.0.0.1
ZION_DAO_API_URL=http://127.0.0.1:8450
ZION_POOL_API_URL=http://127.0.0.1:8455
# Note: ZION_DAO_API_KEY / ZION_WARP_API_KEY are intentionally NOT used server-side.
# The /api/dao and /api/warp proxies require the client to send its own x-dao-key / x-warp-key header.
# Never put admin keys in this file.
ZION_JWT_SECRET=CHANGE_ME_BASE64_48_BYTES

# Admin panel Basic Auth (must be strong, random, >= 32 chars)
ADMIN_USER=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_RANDOM

NODE_ENV=production
PORT=3000

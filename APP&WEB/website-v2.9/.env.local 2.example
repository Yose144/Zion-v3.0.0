# Development environment (local testing against TestNet server)
# API calls go through nginx proxy on TestNet server

# For local development pointing to TestNet
NEXT_PUBLIC_API_URL=https://zionterranova.com/api
NEXT_PUBLIC_BLOCKCHAIN_RPC_URL=https://zionterranova.com/blockchain-rpc
NEXT_PUBLIC_POOL_API_URL=https://zionterranova.com/pool

# OR for testing against localhost (when running backend locally):
# NEXT_PUBLIC_API_URL=http://localhost:8001
# NEXT_PUBLIC_BLOCKCHAIN_RPC_URL=http://localhost:18081
# NEXT_PUBLIC_POOL_API_URL=http://localhost:8080

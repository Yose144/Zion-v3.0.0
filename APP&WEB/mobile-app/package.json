{
  "name": "zion-mobile",
  "version": "3.0.2",
  "description": "ZION TerraNova Mobile Wallet & Mining Manager",
  "main": "index.js",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "lint": "eslint .",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:ios": "cd ios && xcodebuild -workspace ZIONMobile.xcworkspace -scheme ZIONMobile -configuration Release"
  },
  "dependencies": {
    "@expo/metro-runtime": "^6.1.2",
    "@noble/ed25519": "^2.3.0",
    "@noble/hashes": "^2.0.1",
    "@noble/secp256k1": "^2.1.0",
    "@react-native-async-storage/async-storage": "^1.21.0",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/stack": "^6.3.20",
    "@scure/bip32": "^2.0.1",
    "axios": "^1.6.5",
    "bech32": "^2.0.0",
    "bip32": "^4.0.0",
    "bip39": "^3.1.0",
    "bs58": "^6.0.0",
    "bs58check": "^4.0.0",
    "buffer": "^6.0.3",
    "expo": "^54.0.33",
    "react": "18.2.0",
    "react-dom": "^18.2.0",
    "react-native": "0.73.2",
    "react-native-background-fetch": "^4.2.2",
    "react-native-biometrics": "^3.0.1",
    "react-native-camera": "^4.2.1",
    "react-native-crypto-js": "^1.0.0",
    "react-native-device-info": "^10.12.0",
    "react-native-gesture-handler": "^2.14.1",
    "react-native-keychain": "^8.2.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-permissions": "^4.1.0",
    "react-native-push-notification": "^8.1.1",
    "react-native-qrcode-svg": "^6.3.0",
    "react-native-safe-area-context": "^4.8.2",
    "react-native-screens": "^3.29.0",
    "react-native-vector-icons": "^10.0.3",
    "react-native-web": "^0.21.2",
    "stellar-base": "^13.1.0",
    "zion-wallet-sdk": "file:../zion-wallet-sdk"
  },
  "devDependencies": {
    "@babel/core": "^7.23.7",
    "@babel/preset-env": "^7.23.7",
    "@babel/runtime": "^7.23.7",
    "@react-native/eslint-config": "^0.73.2",
    "@react-native/metro-config": "^0.73.3",
    "@react-native/typescript-config": "^0.73.1",
    "@types/react": "^18.2.48",
    "@types/react-test-renderer": "^18.0.7",
    "babel-jest": "^29.7.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "^54.0.10",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "metro-react-native-babel-preset": "^0.77.0",
    "prettier": "^3.1.1",
    "react-test-renderer": "18.2.0",
    "typescript": "^5.3.3"
  },
  "jest": {
    "preset": "react-native",
    "transformIgnorePatterns": [
      "node_modules/(?!((react-native.*)|(@react-native.*)|(@noble/.*)|(bip39)))"
    ],
    "moduleNameMapper": {
      "^@noble/hashes/sha2$": "<rootDir>/node_modules/@noble/hashes/sha2.js"
    }
  },
  "engines": {
    "node": ">=18"
  }
}

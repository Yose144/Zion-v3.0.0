{
  "expo": {
    "name": "ZION Mobile",
    "slug": "zion-mobile",
    "version": "3.0.5",
    "orientation": "portrait",
    "platforms": ["ios", "android", "web"],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0c1c"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zionterranova.mobile",
      "buildNumber": "8",
      "associatedDomains": [
        "applinks:zionterranova.com",
        "applinks:www.zionterranova.com"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "ZION uses the camera to scan QR codes for wallet addresses and payments.",
        "NSFaceIDUsageDescription": "ZION uses Face ID to securely unlock your wallet.",
        "NSBiometryUsageDescription": "ZION uses biometric authentication to protect your private keys.",
        "UIBackgroundModes": ["fetch", "remote-notification"]
      }
    },
    "android": {
      "package": "com.zionterranova.mobile",
      "versionCode": 8,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0c1c"
      },
      "permissions": [
        "CAMERA",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "zionterranova.com",
              "pathPrefix": "/wallet"
            },
            {
              "scheme": "https",
              "host": "zionterranova.com",
              "pathPrefix": "/send"
            },
            {
              "scheme": "https",
              "host": "www.zionterranova.com",
              "pathPrefix": "/wallet"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "zion-mobile"
      }
    }
  }
}

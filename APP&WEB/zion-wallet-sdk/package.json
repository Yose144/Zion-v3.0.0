{
  "name": "zion-wallet-sdk",
  "version": "2.0.0",
  "description": "ZION Wallet SDK — TypeScript library for ZION L1 + multichain wallet operations",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "lint": "eslint src/**/*.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "zion",
    "wallet",
    "blockchain",
    "cryptocurrency",
    "ed25519",
    "multichain",
    "evm",
    "dex",
    "bridge",
    "siwe",
    "zis"
  ],
  "author": "ZION TerraNova",
  "license": "MIT",
  "dependencies": {
    "@noble/ed25519": "^2.3.0",
    "@noble/hashes": "^2.0.1",
    "bip39": "^3.1.0",
    "ethers": "^6.17.0"
  },
  "peerDependencies": {
    "@ledgerhq/hw-app-ada": "^6",
    "@ledgerhq/hw-transport-webhid": "^6",
    "@ledgerhq/hw-transport-webusb": "^6",
    "@trezor/connect": "^9",
    "@trezor/connect-web": "^9"
  },
  "peerDependenciesMeta": {
    "@trezor/connect-web": {
      "optional": true
    },
    "@trezor/connect": {
      "optional": true
    },
    "@ledgerhq/hw-transport-webusb": {
      "optional": true
    },
    "@ledgerhq/hw-transport-webhid": {
      "optional": true
    },
    "@ledgerhq/hw-app-ada": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.5",
    "@ledgerhq/hw-transport-http": "^6.29.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "babel-jest": "^30.4.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18"
  }
}

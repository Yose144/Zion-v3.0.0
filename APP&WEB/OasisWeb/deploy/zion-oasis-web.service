[Unit]
Description=ZION OASIS Web (oasis.zionterranova.com) — Next.js standalone
After=network.target
Wants=network.target

[Service]
Type=simple
User=zion
Group=zion
WorkingDirectory=/opt/zion/oasis-web
EnvironmentFile=/opt/zion/oasis-web/.env
Environment="PORT=3002"
Environment="HOSTNAME=127.0.0.1"
ExecStart=/usr/bin/node /opt/zion/oasis-web/server.js
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zion-oasis-web

# Security
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/zion/oasis-web
PrivateTmp=true

[Install]
WantedBy=multi-user.target

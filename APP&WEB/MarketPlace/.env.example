# ── ZION MarketPlace Environment ────────────────────────────────────

# Database (PostgreSQL)
# The connection string must include a database user. Replace "postgres"
# with the role that owns the zion_marketplace database.
DATABASE_URL="postgresql://postgres@localhost:5432/zion_marketplace"

# Base L2 RPC
NEXT_PUBLIC_BASE_RPC_URL="https://mainnet.base.org"

# WalletConnect
NEXT_PUBLIC_WC_PROJECT_ID="your-walletconnect-project-id"

# Contract addresses (Base Mainnet) — fill after deployment
NEXT_PUBLIC_ARTIFACT_NFT_ADDRESS=""
NEXT_PUBLIC_MARKETPLACE_ADDRESS=""

# wZION address on Base (confirmed — from V3/L2/contracts/hardhat/deployed-base.json)
NEXT_PUBLIC_WZION_ADDRESS="0x0c493763d107ab0ABb0aee1Ca3999292d8202bb6"

# IPFS (Pinata or local node)
IPFS_API_KEY=""
IPFS_API_SECRET=""
IPFS_GATEWAY="https://ipfs.io/ipfs/"

# Shop seed secret (Bearer token for POST /api/shop/seed)
SHOP_SEED_SECRET="zion-dev-seed"

# Admin API key for /api/admin/* and dashboard access
ADMIN_API_KEY="zion-dev-admin-key"

# Admin users for /admin/login (format: username:password,username:password)
ADMIN_USERS="Yose:3nityOne13,Issy:3nityOne13"

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Public site URL for Stripe success/cancel redirects
NEXT_PUBLIC_SITE_URL="https://market.zionterranova.com"

# SMTP / Email notifications (V2 mail.webglobe.cz)
SMTP_HOST="mail.webglobe.cz"
SMTP_PORT="587"
SMTP_USER="shop@newearth.cz"
SMTP_PASSWORD=""
ADMIN_EMAIL="admin@newearth.cz"
SHOP_EMAIL="shop@newearth.cz"
SHOP_NAME="ZION eShop"

# Resend.com email delivery (preferred; overrides SMTP when set)
RESEND_API_KEY=""
RESEND_FROM="shop@newearth.cz"

# Deployer (for forge script — NEVER commit real keys)
DEPLOYER_KEY=""
BASE_RPC_URL="https://mainnet.base.org"

# ── ZION L1 native token payout ───────────────────────────────────────
# Path to the pool wallet JSON file used to pay customer ZION bonuses.
# If the file does not exist, the backend will create it from the
# ZION_L1_POOL_WALLET_MNEMONIC or ZION_L1_POOL_WALLET_SECRET_KEY env var.
ZION_L1_RPC_URL="rpc.zionterranova.com:8443"
ZION_L1_POOL_WALLET_PATH="/etc/zion/MarketPlace/pool-wallet.json"
ZION_L1_POOL_WALLET_MNEMONIC=""
ZION_L1_POOL_WALLET_SECRET_KEY=""
ZION_L1_PAYOUT_FEE="0.01"

# Optional: override the path to the zion CLI binary.
ZION_CLI_PATH="/home/zionserver/2.9.6-main/V31/releases/linux-x86_64/zion"

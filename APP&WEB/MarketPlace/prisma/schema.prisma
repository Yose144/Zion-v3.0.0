// ── ZION MarketPlace Database Schema ───────────────────────────────
// PostgreSQL — off-chain metadata, listings, sales, user profiles

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Artifacts (ERC-1155 NFT metadata) ──────────────────────────────

model Artifact {
  id              String   @id @default(cuid())
  tokenId         BigInt
  contractAddress String
  category        String   @default("quest_item")
  name            String
  description     String   @db.Text
  rarity          String   @default("common")
  source          String   @default("oasis")
  imageUri        String
  assetUri        String?
  metadataUri     String   @default("")

  // Game stats (JSON)
  stats           Json?

  // Provenance
  creator         String
  createdAt       DateTime @default(now())
  mintedAt        DateTime?

  // Supply
  totalSupply     Int      @default(1)
  circulatingSupply Int    @default(1)

  // Relations
  listings        Listing[]
  sales           Sale[]

  @@unique([contractAddress, tokenId])
  @@index([category])
  @@index([rarity])
  @@index([creator])
  @@index([source])
}

// ── Collections (groups of artifacts) ──────────────────────────────

model Collection {
  id            String   @id @default(cuid())
  name          String
  description   String   @db.Text
  bannerImage   String
  logoImage     String
  creator       String
  artifactCount Int      @default(0)
  floorPrice    BigInt?
  totalVolume   BigInt?
  createdAt     DateTime @default(now())

  @@index([creator])
}

// ── Listings (marketplace sale offers) ─────────────────────────────

model Listing {
  id              String   @id @default(cuid())
  artifactId      String
  tokenId         BigInt
  contractAddress String
  seller          String
  saleType        String   @default("fixed") // "fixed" | "auction"
  price           BigInt   // wZION wei
  priceUsd        Float?
  quantity        Int      @default(1)
  status          String   @default("active") // "active" | "sold" | "cancelled" | "expired"
  createdAt       DateTime @default(now())
  expiresAt       DateTime?

  // Auction-specific
  highestBidder   String?
  highestBid      BigInt?
  bidCount        Int      @default(0)

  // Relations
  artifact        Artifact @relation(fields: [artifactId], references: [id])
  bids            Bid[]
  sales           Sale[]

  @@index([seller])
  @@index([status])
  @@index([artifactId])
  @@index([saleType, status])
}

// ── Bids (auction bids) ────────────────────────────────────────────

model Bid {
  id        String   @id @default(cuid())
  listingId String
  bidder    String
  amount    BigInt
  createdAt DateTime @default(now())

  listing   Listing  @relation(fields: [listingId], references: [id])

  @@index([listingId])
  @@index([bidder])
}

// ── Sales (completed transactions) ─────────────────────────────────

model Sale {
  id        String   @id @default(cuid())
  listingId String
  artifactId String
  tokenId   BigInt
  buyer     String
  seller    String
  price     BigInt
  quantity  Int      @default(1)
  txHash    String
  createdAt DateTime @default(now())

  listing   Listing  @relation(fields: [listingId], references: [id])
  artifact  Artifact @relation(fields: [artifactId], references: [id])

  @@index([buyer])
  @@index([seller])
  @@index([artifactId])
  @@index([createdAt])
}

// ── User Profiles ──────────────────────────────────────────────────

model UserProfile {
  address       String   @id
  username      String?
  avatar        String?
  bio           String?  @db.Text
  joinedAt      DateTime @default(now())
  itemsOwned    Int      @default(0)
  itemsCreated  Int      @default(0)
  totalSales    Int      @default(0)
  totalPurchases Int     @default(0)

  @@index([username])
}

// ── Event tracking (on-chain event indexer) ────────────────────────

model EventLog {
  id            String   @id @default(cuid())
  blockNumber   BigInt
  txHash        String
  logIndex      Int
  eventName     String
  contractAddress String
  data          Json
  createdAt     DateTime @default(now())

  @@unique([txHash, logIndex])
  @@index([blockNumber])
  @@index([contractAddress])
  @@index([eventName])
}

// ── eShop (physical + digital products & orders) ───────────────────

model ShopProduct {
  id              String   @id @default(cuid())
  externalId      String   @unique
  name            String
  category        String
  description     String   @db.Text
  priceCzk        Int
  oldPriceCzk     Int?
  image           String
  badge           String?
  inStock         Boolean  @default(true)
  size            String?
  stock           Int      @default(0)
  tokens          Int      @default(0)
  modelUrl        String?
  filesUrl        String?
  instructionsUrl String?
  digital         Boolean  @default(false)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category])
  @@index([active])
  @@index([inStock])
}

model ShopOrder {
  id             String   @id @default(cuid())
  orderId        String   @unique
  status         String   @default("pending") // pending | paid | processing | shipped | completed | cancelled
  paymentStatus  String   @default("pending") // pending | paid | failed
  customerName   String
  customerEmail  String
  customerPhone  String
  shipping       String   // zasilkovna | zasilkovna-home | virtualni-nakup | virtualni-odber
  payment        String   // transfer | card | crypto
  addressStreet  String?
  addressCity    String?
  addressZip     String?
  pickupPoint    Json?
  note           String?  @db.Text
  totalCzk       Int
  shippingCzk    Int
  items          Json
  zionTokens     Int      @default(0)
  trackingNumber String?
  shippedAt      DateTime?
  paidAt         DateTime?
  termsAccepted  Boolean  @default(false)
  newsletter     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  invoices       Invoice[]

  @@index([status])
  @@index([paymentStatus])
  @@index([customerEmail])
  @@index([orderId])
}

model ShopSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Invoice {
  id            String    @id @default(cuid())
  invoiceNumber String    @unique
  orderId       String
  order         ShopOrder @relation(fields: [orderId], references: [id])
  status        String    @default("draft") // draft | issued | paid | cancelled
  totalCzk      Int
  vatCzk        Int?
  dueDate       DateTime?
  issuedAt      DateTime  @default(now())
  paidAt        DateTime?
  html          String?   @db.Text
  pdfUrl        String?
  stripeSession String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([orderId])
  @@index([status])
}

model ShopSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([key])
}

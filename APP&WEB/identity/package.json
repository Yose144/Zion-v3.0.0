{
  "name": "zion-identity-service",
  "version": "0.1.0",
  "private": true,
  "description": "ZION Identity Service (ZIS) — auth.zionterranova.com. Ed25519 + EVM SIWE auth, JWT SSO across .zionterranova.com apps.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "test": "tsx --test test/*.test.ts",
    "start": "node dist/server.js",
    "db:push": "prisma db push --schema ../shared/prisma/schema.prisma",
    "db:generate": "prisma generate --schema ../shared/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema ../shared/prisma/schema.prisma"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@noble/hashes": "^1.4.0",
    "@prisma/client": "^5.18.0",
    "@simplewebauthn/server": "13.3.3",
    "fastify": "^5.12.5",
    "google-auth-library": "^11.1.0",
    "noble-ed25519": "^1.2.6",
    "pino-pretty": "^11.2.2",
    "siwe": "^2.3.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "prisma": "^5.18.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "@peculiar/asn1-android": "2.9.4",
    "@peculiar/asn1-cms": "2.9.4",
    "@peculiar/asn1-csr": "2.9.4",
    "@peculiar/asn1-ecc": "2.9.4",
    "@peculiar/asn1-pfx": "2.9.4",
    "@peculiar/asn1-pkcs8": "2.9.4",
    "@peculiar/asn1-pkcs9": "2.9.4",
    "@peculiar/asn1-rsa": "2.9.4",
    "@peculiar/asn1-schema": "2.9.4",
    "@peculiar/asn1-x509": "2.9.4",
    "@peculiar/asn1-x509-attr": "2.9.4"
  }
}

# ZionOS Edge Pool Configuration
# Copy this to your rig and source it before starting agent/miner.
#
# Edge Pool (Primary Hetzner VPS)
#   Public:  77.42.71.94:8444
#   VPN:     100.76.16.108:8444 (Tailscale fallback)
#
# ── REQUIRED: fill your payout wallet ──
# ZION_MINER_ID=zion1YOUR_WALLET_ADDRESS_HERE
# ZION_WORKER_NAME=your-rig-name
#
# ── Pool ──
ZION_POOL_ADDR=77.42.71.94:8444
# Fallback if Tailscale is up and public IP is blocked:
# ZION_POOL_ADDR=100.76.16.108:8444

# ── Dashboard (if running ZionOS dashboard locally on the rig) ──
# ZIONOS_DASHBOARD_URL=http://127.0.0.1:8888

# ── Miner tuning (tune for your hardware) ──
# CPU threads: 0 = auto-detect, or set manually
ZION_THREADS=0

# GPU backend: auto, opencl, cuda, metal, cpu
ZION_GPU_BACKEND=auto

# Loop count: 1 = legacy (disconnects after each job)
# For sustained mining use a large number or keep reconnect enabled
ZION_LOOP_COUNT=1000000

# Metrics reporting interval
ZION_METRICS_REPORT_SECS=30

# ── Pool metrics for dashboard ──
# Point dashboard at Edge pool HTTP API (runs on stratum port)
ZIONOS_POOL_METRICS=http://77.42.71.94:8444
